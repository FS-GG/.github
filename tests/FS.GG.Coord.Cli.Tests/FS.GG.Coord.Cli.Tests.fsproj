<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>true</GenerateProgramFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- RestorePackagesWithLockFile, RestoreLockedMode and DisableImplicitLibraryPacksFolder (ADR-0006,
         ADR-0032) are INHERITED from the root Directory.Build.props (#609). -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="CacheSandbox.fs" />
    <Compile Include="StructuredFixtures.fs" />
    <Compile Include="SnapshotTests.fs" />
    <Compile Include="ScanRoundTripTests.fs" />
    <Compile Include="CrossRepoRankTests.fs" />
    <!-- PacketCliTests (.github#2737) pins the `packet validate` command boundary: exit codes and
         the stdout/stderr split. The decode and validation contract is pure and lives in
         FS.GG.Coord.Core.Tests/FindingPacketTests.fs. -->
    <Compile Include="PacketCliTests.fs" />
    <Compile Include="SelfHostCliTests.fs" />
    <Compile Include="DriverEventsCliTests.fs" />
    <Compile Include="DocumentedInvocationTests.fs" />
    <Compile Include="SkillProgressiveDisclosureTests.fs" />
    <Compile Include="ExitContractTests.fs" />
    <Compile Include="RuleSubsetTests.fs" />
    <Compile Include="RepoScopeTests.fs" />
    <Compile Include="TouchSetLintTests.fs" />
    <Compile Include="EpicVerdictTests.fs" />
    <Compile Include="ClassLintTests.fs" />
    <Compile Include="CacheIsolationTests.fs" />
    <Compile Include="ChoresTests.fs" />
    <Compile Include="OpLockTests.fs" />
    <Compile Include="OpLockDispatchVerbTests.fs" />
    <Compile Include="CommentMutationTests.fs" />
    <Compile Include="FollowupsTests.fs" />
    <Compile Include="OverlapTests.fs" />
    <Compile Include="ForceStealTests.fs" />
    <Compile Include="WhoLivenessTests.fs" />
    <Compile Include="SchedulingCostTests.fs" />
    <Compile Include="ClaimOverlapTests.fs" />
    <Compile Include="ClaimLifecycleDestinationTests.fs" />
    <Compile Include="ReviewWaitEvidenceTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FS.GG.Coord.Cli/FS.GG.Coord.Cli.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FsCheck.Xunit" />
  </ItemGroup>
</Project>
