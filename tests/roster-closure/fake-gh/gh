#!/usr/bin/env bash
# Typed-command stand-in for roster-closure's caller integration. Pagination/error semantics are
# tested at the canonical F# GraphQl/OperationalGraphQl boundary; this fixture tests projection use.
set -euo pipefail
[ "${1:-}" = graphql ] && [ "${2:-}" = roster-board ] || {
  echo "fake-coord: unsupported args: $*" >&2
  exit 64
}
case "${FAKE_GH_SCENARIO:-}" in
  transport-fail) echo "simulated transport failure" >&2; exit 1 ;;
  bad-json) echo "returned invalid JSON" >&2; exit 1 ;;
  graphql-errors) echo "GraphQL refused the query" >&2; exit 1 ;;
  no-data-key) echo "response carried neither data nor errors" >&2; exit 1 ;;
  project-lookup-zero) echo "expected exactly one project, found 0" >&2; exit 1 ;;
  project-lookup-multi) echo "expected exactly one project, found 2" >&2; exit 1 ;;
  items-not-readable) echo "project was not readable while paging" >&2; exit 1 ;;
  count-mismatch) echo "board item count changed while paging" >&2; exit 1 ;;
  bad-cursor) echo "no endCursor to page with" >&2; exit 1 ;;
  partial-node) echo "partially resolved node" >&2; exit 1 ;;
  draft-issue-skip) printf '%s\n' '[{"owner":"FS-GG","repo":".github","number":1,"status":"Ready"}]' ;;
  two-pages-ok) printf '%s\n' '[{"owner":"FS-GG","repo":"A","number":1,"status":"Ready"},{"owner":"FS-GG","repo":"B","number":2,"status":"Done"}]' ;;
  *) echo "fake-coord: unknown scenario" >&2; exit 64 ;;
esac
