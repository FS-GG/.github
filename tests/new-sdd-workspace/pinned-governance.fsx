// Synthetic SDK registration fixtures carry byte-identical selected public0182 overlay bodies.
// These controls exercise compiled guards; they are not authentic installation/layout evidence.
open NewSddWorkspace.Program
open System
open System.IO
open System.IO.Compression
open System.Text.Json

let fixtureBytes = Convert.FromBase64String ""
let expectOk label = function Ok value -> value | Error note -> failwithf "%s: %s" label note
let expectError label = function Error _ -> () | Ok _ -> failwithf "%s accepted" label
let writeMetadata cache entries =
    Directory.CreateDirectory cache |> ignore
    let packages = entries |> List.map (fun (id, version, archive) -> {| Details = {| PackageId = id; Version = version |}; MountPointUri = archive |})
    File.WriteAllText(Path.Combine(cache, "packages.json"), JsonSerializer.Serialize {| Packages = packages |})
let prepareHive cache =
    Directory.CreateDirectory cache |> ignore
    let package = Path.Combine(cache, "public0182-overlay-fixture.nupkg")
    File.WriteAllBytes(package, fixtureBytes)
    writeMetadata cache [ "FS.GG.Workspace.Template", "0.18.2", package ]
    package
let changeArchive package memberName (replacement: byte array) =
    use input = new MemoryStream(fixtureBytes)
    use original = new ZipArchive(input, ZipArchiveMode.Read)
    use output = File.Create package
    use mutated = new ZipArchive(output, ZipArchiveMode.Create)
    for entry in original.Entries do
        let added = mutated.CreateEntry entry.FullName
        use target = added.Open()
        if entry.FullName = memberName then target.Write(replacement, 0, replacement.Length)
        else
            use source = entry.Open()
            source.CopyTo target
let changeMembership package selected duplicate =
    use input = new MemoryStream(fixtureBytes)
    use original = new ZipArchive(input, ZipArchiveMode.Read)
    use output = File.Create package
    use mutated = new ZipArchive(output, ZipArchiveMode.Create)
    for entry in original.Entries do
        let copies = if entry.FullName = selected then (if duplicate then 2 else 0) else 1
        for _ in 1 .. copies do
            use target = mutated.CreateEntry(entry.FullName).Open()
            use source = entry.Open()
            source.CopyTo target
let snapshot root =
    Directory.GetFiles(root, "*", SearchOption.AllDirectories)
    |> Array.sort
    |> Array.map (fun path -> path, File.ReadAllBytes path)

let args = fsi.CommandLineArgs |> Array.skip 1
if args.Length = 2 && args.[0] = "--prepare-hive" then
    prepareHive args.[1] |> ignore
else
    let root = Path.Combine(Path.GetTempPath(), "wizard-pinned-overlays-" + Guid.NewGuid().ToString "N")
    Directory.CreateDirectory root |> ignore
    let cache = Path.Combine(root, "hive")
    let opts = { assembleWizardOptions (Path.Combine(root, "never-created")) "Product" with Pinned = true; Governance = true }
    try
        pinnedGovernancePreflight opts cache |> expectError "missing registration"
        if Directory.Exists opts.Target then failwith "missing registration created receiver"
        let package = prepareHive cache
        let before = snapshot root
        pinnedGovernanceRegistration cache |> expectOk "exact Governance fixture"
        knowledgeOverlayRegistration cache |> expectOk "exact shared knowledge fixture" |> fun value -> if not value then failwith "knowledge payload missing"
        pinnedGovernancePreflight opts cache |> expectOk "both included overlay preflight"
        if snapshot root <> before then failwith "admission changed cache/package bytes"
        for version in [ "0.18.0"; "0.18.1"; "0.18.3" ] do
            writeMetadata cache [ "FS.GG.Workspace.Template", version, package ]
            pinnedGovernancePreflight opts cache |> expectError ("wrong version " + version)
        writeMetadata cache [ "FS.GG.Workspace.Template", "0.18.2", package; "fs.gg.workspace.template", "0.18.2", package ]
        pinnedGovernancePreflight opts cache |> expectError "duplicate case alias"
        writeMetadata cache [ "FS.GG.Workspace.Template", "0.18.2", package; "FS.GG.Templates", "0.7.1", package ]
        pinnedGovernancePreflight opts cache |> expectError "obsolete ID conflict"
        File.WriteAllText(Path.Combine(cache, "packages.json"), "malformed")
        pinnedGovernancePreflight opts cache |> expectError "malformed metadata"
        prepareHive cache |> ignore
        let bad = Path.Combine(cache, "changed.nupkg")
        for memberName in
            [ "content/templates/fs-gg-governance/.fsgg/policy.yml"
              "content/templates/fs-gg-project-knowledge/scripts/check-project-knowledge.py"
              "FS.GG.Workspace.Template.nuspec" ] do
            changeArchive bad memberName (System.Text.Encoding.UTF8.GetBytes "changed")
            writeMetadata cache [ "FS.GG.Workspace.Template", "0.18.2", bad ]
            pinnedGovernancePreflight opts cache |> expectError ("modified role/source " + memberName)
        for memberName in
            [ "FS.GG.Workspace.Template.nuspec"
              "content/templates/fs-gg-governance/.fsgg/policy.yml"
              "content/templates/fs-gg-project-knowledge/scripts/check-project-knowledge.py" ] do
            for duplicate in [ false; true ] do
                changeMembership bad memberName duplicate
                writeMetadata cache [ "FS.GG.Workspace.Template", "0.18.2", bad ]
                pinnedGovernancePreflight opts cache |> expectError ("missing/duplicate role " + memberName)
        prepareHive cache |> ignore
        let conflict = Path.Combine(cache, "other.nupkg")
        for shortName in [ "\"fs-gg-governance\""; "[\"other\",\"fs-gg-project-knowledge\"]" ] do
            do
                use stream = File.Create conflict
                use archive = new ZipArchive(stream, ZipArchiveMode.Create)
                use writer = new StreamWriter(archive.CreateEntry("content/other/.template.config/template.json").Open())
                writer.Write("{\"identity\":\"Other.Template\",\"shortName\":" + shortName + "}")
            writeMetadata cache [ "FS.GG.Workspace.Template", "0.18.2", package; "Other.Package", "1.0.0", conflict ]
            pinnedGovernancePreflight opts cache |> expectError "conflicting shortname"
        do
            use stream = File.Create conflict
            use archive = new ZipArchive(stream, ZipArchiveMode.Create)
            use writer = new StreamWriter(archive.CreateEntry("content/other/.template.config/template.json").Open())
            writer.Write("""{"identity":"Other.Template","shortName":"other-template"}""")
        writeMetadata cache [ "FS.GG.Workspace.Template", "0.18.2", package; "Other.Package", "1.0.0", conflict ]
        pinnedGovernancePreflight opts cache |> expectOk "unrelated installed template preserved"
        // Missing sibling registration metadata is not silently treated as no conflict.
        writeMetadata cache [ "FS.GG.Workspace.Template", "0.18.2", package; "Other.Package", "1.0.0", Path.Combine(cache, "missing.nupkg") ]
        pinnedGovernancePreflight opts cache |> expectError "unreadable other registration"
        pinnedGovernancePreflight { opts with Pinned = false } cache |> expectOk "unpinned behavior"
        pinnedGovernancePreflight { opts with Governance = false; Lifecycle = "typed-sdd"; LifecycleExplicit = true } cache |> expectError "pinned knowledge cannot bypass shared registration"
        if scaffoldUpdateArgs true <> [ "--no-update" ] || scaffoldUpdateArgs false <> [] then failwith "scaffold update authority changed"
        let previousCliHome = Environment.GetEnvironmentVariable "DOTNET_CLI_HOME"
        try
            Environment.SetEnvironmentVariable("DOTNET_CLI_HOME", Path.Combine(root, "missing-cli-home"))
            let argv = [| opts.Target; "Product"; "--pinned"; "--no-coordination" |]
            let exitCode = typeof<Options>.Assembly.EntryPoint.Invoke(null, [| box argv |]) :?> int
            if exitCode <> 2 then failwithf "missing pinned overlays reached creation: exit%d" exitCode
        finally Environment.SetEnvironmentVariable("DOTNET_CLI_HOME", previousCliHome)
        if Directory.Exists opts.Target then failwith "overlay refusal wrote receiver"
    finally Directory.Delete(root, true)
    printfn "pinned included overlays: exact shared0182, refusal, preservation and scaffold authority controls ok"
