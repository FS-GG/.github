<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE INCIDENT LOG, AS TESTS (ADR-0034, Phase 1).
       The 4,000 lines of bash this core will replace are not just code — they are a record of every
       way this domain has gone wrong, written down by the people it went wrong for. Porting that
       record into named regression tests, BEFORE any of the new code is trusted, is the point of the
       phase. Every test below carries the number of the issue that bought it. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>true</GenerateProgramFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- RestorePackagesWithLockFile, RestoreLockedMode and DisableImplicitLibraryPacksFolder (ADR-0006,
         ADR-0032) are INHERITED from the root Directory.Build.props, which imports the org-shared
         config this repo authors and ships. They were set here by hand only because .github did not
         consume its own build config (#609). It does now. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SelfHostTests.fs" />
    <Compile Include="TypesTests.fs" />
    <Compile Include="RepoScopeTests.fs" />
    <Compile Include="MarkdownTests.fs" />
    <Compile Include="SemanticDiffTests.fs" />
    <Compile Include="TouchSetTests.fs" />
    <Compile Include="HumanBlockTests.fs" />
    <Compile Include="ClassTests.fs" />
    <Compile Include="KindTests.fs" />
    <Compile Include="RoomsTests.fs" />
    <Compile Include="EpicBodyTests.fs" />
    <Compile Include="CoversTests.fs" />
    <Compile Include="BlockerTests.fs" />
    <Compile Include="SchedulabilityTests.fs" />
    <Compile Include="RankTests.fs" />
    <Compile Include="BatchTests.fs" />
    <Compile Include="DriverTests.fs" />
    <Compile Include="DriverEventsTests.fs" />
    <Compile Include="CycleLedgerTests.fs" />
    <Compile Include="DeliveryTests.fs" />
    <Compile Include="LifecycleProjectionTests.fs" />
    <Compile Include="ProtocolTests.fs" />
    <Compile Include="LanesTests.fs" />
    <Compile Include="LandableTests.fs" />
    <Compile Include="ChoreTests.fs" />
    <Compile Include="KitTests.fs" />
    <Compile Include="RegistryPredicateTests.fs" />
    <Compile Include="IntakeTests.fs" />
    <Compile Include="DeliveryRouteTests.fs" />
    <Compile Include="StructuredDecisionTests.fs" />
    <!-- OpKeyTests (.github#2311) drives the new pure Operation module — the operation key, its closed
         vocabulary, and the composition every later fencing slice will share. Like every entry above it
         this one is explicit: the list carries no globs, so an unlisted test file runs nowhere. -->
    <Compile Include="OpKeyTests.fs" />
    <!-- ReviewHeadDivergenceTests (.github#2487) reuses StructuredDecisionTests' record/comment builders,
         so it must compile AFTER that entry. Same rule as every line above it: the list carries no globs,
         and an unlisted file is a suite that runs nowhere. -->
    <Compile Include="ReviewHeadDivergenceTests.fs" />
    <Compile Include="ReviewWaitTests.fs" />
    <!-- FindingPacketTests (.github#2737) drives the new pure FindingPacket module against a corpus of
         REAL packets lifted from the live registers .github#2691 and .github#2687. Same rule as every
         line above it: the list carries no globs, and an unlisted file is a suite that runs nowhere. -->
    <Compile Include="FindingPacketTests.fs" />
    <!-- ChurnReadingTests (.github#2739) drives the new pure ChurnReading module against the REAL
         2026-08-15 worked reading in .claude/skills/board-analyst/references/churn-reading.md, lifted
         field by field. Same rule as every line above it: the list carries no globs, and an unlisted
         file is a suite that runs nowhere. -->
    <Compile Include="ChurnReadingTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FS.GG.Coord.Core/FS.GG.Coord.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="fixtures/structured-decisions/active-migration.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- .github#2737: real packets, lifted field by field from the live registers. Each file is named
         for the GitHub comment id it came from, so the lift is checkable against the original. -->
    <Content Include="fixtures/finding-packets/accept-5304198465.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/finding-packets/accept-5307639382.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/finding-packets/accept-5307153964.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/finding-packets/reject-5304189944-no-paths.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/finding-packets/reject-5309266535-not-a-finding.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/finding-packets/reject-5306816009-increment.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/finding-packets/reject-5311301051-no-derived-by.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/finding-packets/reject-5304198465-sentinels-as-none.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- .github#2739: the 2026-08-15 worked reading, lifted field by field from
         .claude/skills/board-analyst/references/churn-reading.md so the schema is proven against a pass
         that actually happened rather than one constructed to fit it (AC5). -->
    <Content Include="fixtures/churn-readings/worked-2026-08-15.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FsCheck.Xunit" />
  </ItemGroup>

</Project>
