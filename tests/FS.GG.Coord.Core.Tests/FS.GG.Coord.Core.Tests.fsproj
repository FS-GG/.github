<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE INCIDENT LOG, AS TESTS (ADR-0034, Phase 1).
       The 4,000 lines of bash this core will replace are not just code — they are a record of every
       way this domain has gone wrong, written down by the people it went wrong for. Porting that
       record into named regression tests, BEFORE any of the new code is trusted, is the point of the
       phase. Every test below carries the number of the issue that bought it. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>true</GenerateProgramFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- RestorePackagesWithLockFile, RestoreLockedMode and DisableImplicitLibraryPacksFolder (ADR-0006,
         ADR-0032) are INHERITED from the root Directory.Build.props, which imports the org-shared
         config this repo authors and ships. They were set here by hand only because .github did not
         consume its own build config (#609). It does now. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TypesTests.fs" />
    <Compile Include="MarkdownTests.fs" />
    <Compile Include="TouchSetTests.fs" />
    <Compile Include="HumanBlockTests.fs" />
    <Compile Include="ClassTests.fs" />
    <Compile Include="RoomsTests.fs" />
    <Compile Include="EpicBodyTests.fs" />
    <Compile Include="CoversTests.fs" />
    <Compile Include="BlockerTests.fs" />
    <Compile Include="SchedulabilityTests.fs" />
    <Compile Include="RankTests.fs" />
    <Compile Include="BatchTests.fs" />
    <Compile Include="DriverTests.fs" />
    <Compile Include="CycleLedgerTests.fs" />
    <Compile Include="DeliveryTests.fs" />
    <Compile Include="ProtocolTests.fs" />
    <Compile Include="LanesTests.fs" />
    <Compile Include="LandableTests.fs" />
    <Compile Include="ChoreTests.fs" />
    <Compile Include="KitTests.fs" />
    <Compile Include="RegistryPredicateTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FS.GG.Coord.Core/FS.GG.Coord.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FsCheck.Xunit" />
  </ItemGroup>

</Project>
