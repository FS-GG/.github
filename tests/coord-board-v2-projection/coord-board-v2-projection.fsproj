<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProgrammeFixture.fs" />
    <Compile Include="MigrationFixture.fs" />
    <Compile Include="V2ProjectionTests.fs" />
    <Compile Include="V2InspectionAcquisitionTests.fs" />
    <Compile Include="V2ObservationTransportTests.fs" />
    <Compile Include="V2MigrationTests.fs" />
    <Compile Include="V2EnrollmentPr1Base.fs" />
    <Compile Include="V2EnrollmentTests.fs" />
    <Compile Include="V2EnrollmentDifferentialTests.fs" />
    <Compile Include="V2PreflightTests.fs" />
    <Compile Include="V2ConstructorClosureTests.fs" />
    <Compile Include="V2NativeResolveTests.fs" />
    <Compile Include="V2RoutesTests.fs" />
    <Compile Include="V2TendTests.fs" />
    <Compile Include="V2TendReadsTests.fs" />
    <Compile Include="TendFakeGitHub.fs" />
    <Compile Include="V2TendWriteTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FS.GG.Coord.GitHub/FS.GG.Coord.GitHub.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
