<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ReaderSourceRoot Condition="'$(ReaderSourceRoot)' == ''">../../../src/FS.GG.Coord.Cli</ReaderSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <Compile Include="$(ReaderSourceRoot)/SkillTelemetryReaders.fsi" Link="SkillTelemetryReaders.fsi" />
    <Compile Include="$(ReaderSourceRoot)/SkillTelemetryReaders.fs" Link="SkillTelemetryReaders.fs" />
    <Compile Include="../../../src/FS.GG.Coord.Cli/SkillTelemetryAdapter.fsi" Link="SkillTelemetryAdapter.fsi" />
    <Compile Include="../../../src/FS.GG.Coord.Cli/SkillTelemetryAdapter.fs" Link="SkillTelemetryAdapter.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
