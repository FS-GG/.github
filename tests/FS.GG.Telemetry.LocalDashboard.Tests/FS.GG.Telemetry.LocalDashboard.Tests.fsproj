<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FS.GG.Telemetry.Dashboard/FS.GG.Telemetry.Dashboard.fsproj" />
    <Compile Include="../../src/FS.GG.Coord.Cli/TelemetryDashboardServer.fsi" Link="TelemetryDashboardServer.fsi" />
    <Compile Include="../../src/FS.GG.Coord.Cli/TelemetryDashboardServer.fs" Link="TelemetryDashboardServer.fs" />
    <Compile Include="ServerTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="browser-journey.mjs" />
    <None Include="package.json" />
    <None Include="package-lock.json" Condition="Exists('package-lock.json')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
</Project>
