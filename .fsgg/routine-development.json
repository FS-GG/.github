{
  "schema": "fsgg.routine-development-policy/v1",
  "status": "pilot",
  "prospective": true,
  "branchPrefix": "routine/",
  "allowedOperations": [
    "source-change",
    "internal-docs"
  ],
  "protectedOperations": [
    "publish",
    "deploy",
    "credential-change",
    "destructive-effect",
    "migration-cutover",
    "external-contract-acceptance",
    "strict-item-continuation"
  ],
  "protectedPaths": [
    ".fsgg/",
    ".github/workflows/release-",
    ".github/workflows/dispatch-",
    ".github/workflows/fsgg-dispatch-",
    "registry/"
  ],
  "requiredChecks": [
    "repository-required-status-checks",
    "routine-head-binding"
  ],
  "notRequired": [
    "issue",
    "claim",
    "sdd-artifacts",
    "phase-lifecycle-ledger",
    "independent-critic",
    "feedback-report",
    "receipt-cycle",
    "metadata-done"
  ],
  "legacyAuthority": "strict"
}
