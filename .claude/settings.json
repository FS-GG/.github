{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-merge-and-main-push.sh\"",
            "if": "Bash(gh pr merge *)",
            "statusMessage": "Checking merge guard..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-merge-and-main-push.sh\"",
            "if": "Bash(gh api *)",
            "statusMessage": "Checking merge guard..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-merge-and-main-push.sh\"",
            "if": "Bash(git push *)",
            "statusMessage": "Checking push guard..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-merge-and-main-push.sh\"",
            "if": "Bash(git push)",
            "statusMessage": "Checking push guard..."
          }
        ]
      }
    ]
  }
}
