{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "fsgg": {
      "source": {
        "source": "github",
        "repo": "FS-GG/.github"
      }
    }
  },
  "enabledPlugins": {
    "fsgg-routes@fsgg": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/skill-view-check.sh\"",
            "statusMessage": "Checking agent skills are visible..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-merge-and-main-push.sh\"",
            "statusMessage": "Checking push guard..."
          }
        ]
      }
    ]
  }
}
