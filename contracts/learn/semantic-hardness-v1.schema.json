{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "item_id",
    "scope_clarity",
    "demand",
    "work_volume",
    "facets",
    "safety",
    "conditions",
    "worked_time"
  ],
  "properties": {
    "schema": {
      "const": "fsgg.semantic-hardness/1"
    },
    "item_id": {
      "type": "string",
      "pattern": "^trial-[0-9]{3}$"
    },
    "scope_clarity": {
      "enum": [
        "clear",
        "partial",
        "insufficient"
      ]
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "confidence",
        "basis",
        "evidence"
      ],
      "properties": {
        "category": {
          "enum": [
            "minimal",
            "bounded",
            "complex",
            "research",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line_start",
              "line_end",
              "quote"
            ],
            "properties": {
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              }
            }
          }
        }
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decomposition",
        "coupling",
        "reasoning",
        "novelty",
        "validation"
      ],
      "properties": {
        "decomposition": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "coupling": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "reasoning": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "novelty": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "validation": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consequence",
        "basis"
      ],
      "properties": {
        "consequence": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_wait",
        "missing_context"
      ],
      "properties": {
        "external_wait": {
          "enum": [
            "none_declared",
            "possible",
            "explicit",
            "unknown"
          ]
        },
        "missing_context": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          }
        }
      }
    },
    "worked_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "p10_minutes",
        "p50_minutes",
        "p90_minutes",
        "confidence"
      ],
      "properties": {
        "reference": {
          "const": "reference-agent-work/1"
        },
        "p10_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p50_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p90_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "work_volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "basis"
      ],
      "properties": {
        "category": {
          "enum": [
            "small",
            "moderate",
            "large",
            "unknown"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fsgg:semantic-hardness:1",
  "description": "Structural response schema; runtime validator additionally checks task identity, exact evidence quote/line relation, and all-null or ordered finite time bounds."
}
