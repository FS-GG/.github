  "requirements": [
    {
      "id": "FR-001",
      "title": "Absent \u0060Facts.CriticSuccessionGranted\u0060, \u0060Review.classify\u0060 MUST return \u0060ResumeSameCritic\u0060 for an unconfirmed changes-required round exactly as before this change. (covers AC-001)",
      "text": "Absent \u0060Facts.CriticSuccessionGranted\u0060, \u0060Review.classify\u0060 MUST return \u0060ResumeSameCritic\u0060 for an unconfirmed changes-required round exactly as before this change. (covers AC-001)",
      "acceptanceCriteria": [
        "AC-001"
      ],
      "priority": null,
      "classification": [],
