    {
      "id": "FR-002",
      "title": "\u0060Review.classify\u0060 MUST return \u0060EnterCriticSuccession\u0060 carrying the granted receipt when, and only when, the receipt\u0027s \u0060OriginalCriticIdentity\u0060 matches the chain\u0027s recorded critic, its \u0060CandidateHeadSha\u0060 equals the binding\u0027s exact head SHA, and both \u0060SuccessorCriticIdentity\u0060 and \u0060GrantedBy\u0060 differ from \u0060Binding.ImplementerIdentity\u0060, identically in the ordinary and repair-phase branches. (covers AC-002, AC-005)",
      "text": "\u0060Review.classify\u0060 MUST return \u0060EnterCriticSuccession\u0060 carrying the granted receipt when, and only when, the receipt\u0027s \u0060OriginalCriticIdentity\u0060 matches the chain\u0027s recorded critic, its \u0060CandidateHeadSha\u0060 equals the binding\u0027s exact head SHA, and both \u0060SuccessorCriticIdentity\u0060 and \u0060GrantedBy\u0060 differ from \u0060Binding.ImplementerIdentity\u0060, identically in the ordinary and repair-phase branches. (covers AC-002, AC-005)",
      "acceptanceCriteria": [
        "AC-002",
        "AC-005"
      ],
      "priority": null,
      "classification": [],
      "source": "work/2417-critic-despawn-review-recovery/spec.md",
