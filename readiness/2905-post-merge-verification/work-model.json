  "decisions": [
    {
      "id": "DEC-001",
      "title": "Add a closed \u0060PostMergeVerification\u0060 domain value whose verified arm carries an immutable receipt. Derive it from paginated Actions workflow runs filtered to the exact merge SHA, \u0060push\u0060 event, and merged PR base/default branch. On a complete readable inventory, any matching completed-success run verifies and the receipt retains every matching run; only when no qualifying success exists does a matching pending run wait, a completed matching non-success fail, or an empty matching set remain absent. Partial, malformed, or transport-failed reads are unreadable and never collapse to absent or verified.",
      "decision": "Add a closed \u0060PostMergeVerification\u0060 domain value whose verified arm carries an immutable receipt. Derive it from paginated Actions workflow runs filtered to the exact merge SHA, \u0060push\u0060 event, and merged PR base/default branch. On a complete readable inventory, any matching completed-success run verifies and the receipt retains every matching run; only when no qualifying success exists does a matching pending run wait, a completed matching non-success fail, or an empty matching set remain absent. Partial, malformed, or transport-failed reads are unreadable and never collapse to absent or verified.",
      "requirementRefs": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-005"
      ],
      "storyRefs": [],
      "acceptanceRefs": [
