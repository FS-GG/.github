        "column": 1
      },
      "linkedTaskIds": [
        "T001"
      ],
      "linkedEvidenceIds": [
        "EV001",
        "EV011"
      ]
    },
    {
      "id": "FR-002",
      "title": "Completion admission fails closed unless verification is a successful, completed execution for the exact merge SHA on the repository default branch; PR-head success, reachability, an empty run set, mismatched executions, and read failures never imply verification. (Stories: US-001, US-002; Acceptance: AC-001, AC-003)",
      "text": "Completion admission fails closed unless verification is a successful, completed execution for the exact merge SHA on the repository default branch; PR-head success, reachability, an empty run set, mismatched executions, and read failures never imply verification. (Stories: US-001, US-002; Acceptance: AC-001, AC-003)",
      "acceptanceCriteria": [
        "AC-001",
        "AC-003"
      ],
      "priority": null,
      "classification": [],
      "source": "work/2905-post-merge-verification/spec.md",
