      ]
    },
    {
      "id": "FR-004",
      "title": "\u0060Done\u0060, issue closure, claim release, board \u0060Status=Done\u0060, and \u0060fsgg.coord.delivery-completion/v1\u0060 creation remain unreachable until exact-merge verification and every pre-existing completion obligation pass. (Stories: US-001, US-002; Acceptance: AC-003, AC-004)",
      "text": "\u0060Done\u0060, issue closure, claim release, board \u0060Status=Done\u0060, and \u0060fsgg.coord.delivery-completion/v1\u0060 creation remain unreachable until exact-merge verification and every pre-existing completion obligation pass. (Stories: US-001, US-002; Acceptance: AC-003, AC-004)",
