  "requirements": [
    {
      "id": "FR-001",
      "title": "\u0060Blocked by\u0060 add canonicalizes and unions requested refs with the live canonical set, removes duplicates, and preserves every existing edge. (Stories: US-001; Acceptance: AC-001)",
      "text": "\u0060Blocked by\u0060 add canonicalizes and unions requested refs with the live canonical set, removes duplicates, and preserves every existing edge. (Stories: US-001; Acceptance: AC-001)",
      "acceptanceCriteria": [
        "AC-001"
      ],
      "priority": null,
      "classification": [],
      "source": "work/2907-blocked-by-set-mutations/spec.md",
      "sourceLocation": {
        "line": 37,
        "column": 1
      },
      "linkedTaskIds": [
        "T001"
      ],
      "linkedEvidenceIds": [
        "EV001"
      ]
    },
    {
      "id": "FR-002",
      "title": "\u0060Blocked by\u0060 remove canonicalizes and subtracts requested refs from the live canonical set, preserves every non-requested edge, and uses the distinct clear mutation when the result is empty. (Stories: US-001; Acceptance: AC-002)",
      "text": "\u0060Blocked by\u0060 remove canonicalizes and subtracts requested refs from the live canonical set, preserves every non-requested edge, and uses the distinct clear mutation when the result is empty. (Stories: US-001; Acceptance: AC-002)",
      "acceptanceCriteria": [
        "AC-002"
      ],
      "priority": null,
      "classification": [],
      "source": "work/2907-blocked-by-set-mutations/spec.md",
      "sourceLocation": {
        "line": 38,
        "column": 1
      },
      "linkedTaskIds": [
        "T002"
      ],
      "linkedEvidenceIds": [
        "EV002"
      ]
    },
    {
      "id": "FR-003",
      "title": "Because Projects-v2 exposes no compare-and-set mutation, every authoritative \u0060Blocked by\u0060 writer (add/remove, explicit replacement/clear, batch, release, intake, reconcile, and deferred \u0060flush\u0060 replay) acquires the same server-ordered issue-comment mutation lease before observing or writing the field and retains it through the GraphQL mutation. A contended or uncertain replay remains queued without duplication; a replay known to have landed is removed even if lease cleanup is uncertain. Add/remove additionally bind the live field value and Projects-v2 item revision; a changed value or revision at the guarded write boundary fails stale and emits no mutation. (Stories: US-001; Acceptance: AC-001, AC-002, AC-003)",
      "text": "Because Projects-v2 exposes no compare-and-set mutation, every authoritative \u0060Blocked by\u0060 writer (add/remove, explicit replacement/clear, batch, release, intake, reconcile, and deferred \u0060flush\u0060 replay) acquires the same server-ordered issue-comment mutation lease before observing or writing the field and retains it through the GraphQL mutation. A contended or uncertain replay remains queued without duplication; a replay known to have landed is removed even if lease cleanup is uncertain. Add/remove additionally bind the live field value and Projects-v2 item revision; a changed value or revision at the guarded write boundary fails stale and emits no mutation. (Stories: US-001; Acceptance: AC-001, AC-002, AC-003)",
      "acceptanceCriteria": [
        "AC-001",
        "AC-002",
        "AC-003"
      ],
      "priority": null,
      "classification": [],
      "source": "work/2907-blocked-by-set-mutations/spec.md",
      "sourceLocation": {
        "line": 39,
        "column": 1
      },
      "linkedTaskIds": [
        "T003"
      ],
      "linkedEvidenceIds": [
        "EV003"
      ]
    },
    {
      "id": "FR-004",
      "title": "The command names add, remove, replace, and clear as distinct caller intents for \u0060Blocked by\u0060; an ambiguous bare replacement is refused while unrelated scalar-field syntax remains compatible. (Stories: US-001; Acceptance: AC-004)",
      "text": "The command names add, remove, replace, and clear as distinct caller intents for \u0060Blocked by\u0060; an ambiguous bare replacement is refused while unrelated scalar-field syntax remains compatible. (Stories: US-001; Acceptance: AC-004)",
