    {
      "id": "FR-001",
      "title": "Archive every frozen measured receipt atomically under a canonical per-user content-addressed path with private permissions and resolve it by digest. (Stories: US-001; Acceptance: AC-001)",
      "text": "Archive every frozen measured receipt atomically under a canonical per-user content-addressed path with private permissions and resolve it by digest. (Stories: US-001; Acceptance: AC-001)",
      "acceptanceCriteria": [
        "AC-001"
