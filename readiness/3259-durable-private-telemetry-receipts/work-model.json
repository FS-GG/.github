    {
      "id": "FR-002",
      "title": "Reject digest collisions, corrupted stored receipts, temporary-only store roots, and caller-reconstructed counts before accepting lifecycle evidence. (Stories: US-001; Acceptance: AC-002)",
      "text": "Reject digest collisions, corrupted stored receipts, temporary-only store roots, and caller-reconstructed counts before accepting lifecycle evidence. (Stories: US-001; Acceptance: AC-002)",
      "acceptanceCriteria": [
        "AC-002"
      ],
      "priority": null,
      "classification": [],
