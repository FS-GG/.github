        "column": 1
      },
      "linkedTaskIds": [
        "T001"
      ],
      "linkedEvidenceIds": [
        "EV001"
      ]
    },
    {
      "id": "FR-002",
      "title": "A chain that is well-formed, host-accepted, critic-identified and bound to \u0060Binding.HeadSha\u0060 MUST report the new \u0060AcceptedAwaitingChecks\u0060 state whenever the live check state is not green, with \u0060stateErrors\u0060 null; its action MUST be \u0060AuthorizeDelivery\u0060 for a pending or unknown check state, \u0060ResumeImplementer\u0060 for red or conflicted, and \u0060Park\u0060 for merged or closed. (covers AC-001, AC-002, AC-005)",
      "text": "A chain that is well-formed, host-accepted, critic-identified and bound to \u0060Binding.HeadSha\u0060 MUST report the new \u0060AcceptedAwaitingChecks\u0060 state whenever the live check state is not green, with \u0060stateErrors\u0060 null; its action MUST be \u0060AuthorizeDelivery\u0060 for a pending or unknown check state, \u0060ResumeImplementer\u0060 for red or conflicted, and \u0060Park\u0060 for merged or closed. (covers AC-001, AC-002, AC-005)",
      "acceptanceCriteria": [
        "AC-001",
        "AC-002",
        "AC-005"
      ],
      "priority": null,
      "classification": [],
