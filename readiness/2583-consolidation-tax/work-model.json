  "decisions": [
    {
      "id": "DEC-001",
      "title": "Adopt the structural subsequence rule and accept that an insertion can redefine scope; discharge it with FR-004\u0027s mandatory reporting of the additive match and the inserted-line count, never with silence.",
      "decision": "Adopt the structural subsequence rule and accept that an insertion can redefine scope; discharge it with FR-004\u0027s mandatory reporting of the additive match and the inserted-line count, never with silence.",
