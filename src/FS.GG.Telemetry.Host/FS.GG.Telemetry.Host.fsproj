<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <UseAppHost>false</UseAppHost>
    <RollForward>Major</RollForward>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <RealSig>true</RealSig>
    <!-- Independent one-package release line. This literal deliberately does not resolve from
         FsggCoherentSetVersion, which belongs only to Kit, Drivers and Coord.Cli. -->
    <FsggCoherentSetVersion />
    <Version>0.8.0</Version>
    <PackageId>FS.GG.Telemetry.Host</PackageId>
    <AssemblyName>FS.GG.Telemetry.Host</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsgg-telemetry-host</ToolCommandName>
    <Description>Optional authenticated FS-GG telemetry host for explicitly enrolled private workspaces.</Description>
    <Authors>FS-GG</Authors>
    <Company>FS-GG</Company>
    <PackageTags>fsgg;telemetry;host;dotnet-tool;fsharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/FS-GG/.github</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/FS-GG/.github/tree/main/src/FS.GG.Telemetry.Host</PackageProjectUrl>
    <PackageReleaseNotes>0.8.0 — Prospective independent Host release of the accepted bounded unassigned-usage dashboard projection. Package qualification checks corrected private observations in the actual installed browser before and after restore, with partial population and unknown attribution/cost. Store14 and the existing receipt ABI are unchanged. Host0.7 publication/journal13 and Host0.6 journal12/tag intent remain immutable. Source preparation does not qualify coordinate availability, publication or receiver adoption.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FS.GG.Coord.Cli/SkillTelemetryReaders.fsi" Link="SkillTelemetryReaders.fsi" />
    <Compile Include="../FS.GG.Coord.Cli/SkillTelemetryReaders.fs" Link="SkillTelemetryReaders.fs" />
    <Compile Include="BrowserSecurity.fsi" />
    <Compile Include="BrowserSecurity.fs" />
    <Compile Include="HostRuntime.fsi" />
    <Compile Include="HostRuntime.fs" />
    <Compile Include="NativeDeliverySource.fsi" />
    <Compile Include="NativeDeliverySource.fs" />
    <Compile Include="NativeSourceVerification.fsi" />
    <Compile Include="NativeSourceVerification.fs" />
    <Compile Include="NativeResponsesCollection.fsi" />
    <Compile Include="NativeResponsesCollection.fs" />
    <Compile Include="NativeResponsesFacts.fsi" />
    <Compile Include="NativeResponsesFacts.fs" />
    <Compile Include="NativeResponsesAssessment.fsi" />
    <Compile Include="NativeResponsesAssessment.fs" />
    <Compile Include="NativeResponsesEntry.fsi" />
    <Compile Include="NativeResponsesEntry.fs" />
    <Compile Include="BrowserEndpoints.fsi" />
    <Compile Include="BrowserEndpoints.fs" />
    <Compile Include="InactivePreparation.fsi" />
    <Compile Include="InactivePreparation.fs" />
    <Compile Include="Program.fsi" />
    <Compile Include="Program.fs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute"><_Parameter1>FS.GG.Telemetry.Tests</_Parameter1></AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FS.GG.Telemetry.Contracts/FS.GG.Telemetry.Contracts.fsproj" />
    <ProjectReference Include="../FS.GG.Telemetry.Client/FS.GG.Telemetry.Client.fsproj" />
    <ProjectReference Include="../FS.GG.Telemetry.Dashboard/FS.GG.Telemetry.Dashboard.fsproj" />
    <ProjectReference Include="../FS.GG.Telemetry.Store/FS.GG.Telemetry.Store.fsproj" />
    <ProjectReference Include="../FS.GG.Coord.GitHub/FS.GG.Coord.GitHub.fsproj" />
    <PackageReference Include="Akka" />
    <PackageReference Include="Akka.FSharp" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
