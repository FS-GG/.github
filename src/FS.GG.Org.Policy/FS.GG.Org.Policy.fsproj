<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WorkflowSyntax.fs" />
    <Compile Include="GitTreeProjects.fs" />
    <Compile Include="GitCommitProvenance.fs" />
    <Compile Include="GitHubCommitMembership.fs" />
    <Compile Include="GitHubGraphQlHttp.fs" />
    <Compile Include="ProjectReferenceXml.fs" />
    <Compile Include="RuleA.fs" />
    <Compile Include="RuleB.fs" />
    <Compile Include="RuleBExceptions.fs" />
    <Compile Include="RuleBWorkflow.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FS.GG.Org.Policy.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
