<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WorkflowSyntax.fsi" />
    <Compile Include="WorkflowSyntax.fs" />
    <Compile Include="ProjectReferenceXml.fsi" />
    <Compile Include="ProjectReferenceXml.fs" />
    <Compile Include="RuleA.fsi" />
    <Compile Include="RuleA.fs" />
    <Compile Include="RuleB.fsi" />
    <Compile Include="RuleB.fs" />
    <Compile Include="RuleBExceptions.fsi" />
    <Compile Include="RuleBExceptions.fs" />
    <Compile Include="RuleBWorkflow.fsi" />
    <Compile Include="RuleBWorkflow.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
</Project>
