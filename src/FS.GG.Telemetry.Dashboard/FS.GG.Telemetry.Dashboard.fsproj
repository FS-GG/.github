<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DashboardProjection.fsi" />
    <Compile Include="DashboardProjection.fs" />
    <EmbeddedResource Include="Assets/index.html" LogicalName="FS.GG.Telemetry.Dashboard.Assets.index.html" />
    <EmbeddedResource Include="Assets/app.js" LogicalName="FS.GG.Telemetry.Dashboard.Assets.app.js" />
    <EmbeddedResource Include="Assets/styles.css" LogicalName="FS.GG.Telemetry.Dashboard.Assets.styles.css" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
