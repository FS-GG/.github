<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FS.GG.Coord.Cli/Snapshot.fsi" Link="Snapshot.fsi" />
    <Compile Include="../FS.GG.Coord.Cli/Snapshot.fs" Link="Snapshot.fs" />
    <Compile Include="DeliveryApplication.fsi" />
    <Compile Include="DeliveryApplication.fs" />
    <Compile Include="ReviewApplication.fsi" />
    <Compile Include="ReviewApplication.fs" />
    <Compile Include="DeliveryRouteApplication.fsi" />
    <Compile Include="DeliveryRouteApplication.fs" />
    <Compile Include="FollowupAudit.fsi" />
    <Compile Include="FollowupAudit.fs" />
    <Compile Include="Followups.fsi" />
    <Compile Include="Followups.fs" />
    <Compile Include="LiveHandlers.fsi" />
    <Compile Include="LiveHandlers.fs" />
    <Compile Include="HandlerRegistration.fsi" />
    <Compile Include="HandlerRegistration.fs" />
    <Compile Include="Handlers.fsi" />
    <Compile Include="Handlers.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FS.GG.Coord.Cli.Kernel/FS.GG.Coord.Cli.Kernel.fsproj" />
    <ProjectReference Include="../FS.GG.Coord.Core/FS.GG.Coord.Core.fsproj" />
    <ProjectReference Include="../FS.GG.Coord.GitHub/FS.GG.Coord.GitHub.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
