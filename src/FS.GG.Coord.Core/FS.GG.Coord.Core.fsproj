<Project Sdk="Microsoft.NET.Sdk">

  <!-- FS.GG.Coord.Core — the coordination domain, as types (ADR-0034, Phase 1).
       PURE. No IO, no `gh`, no network, no filesystem. It takes a Board and an Item and returns a
       verdict; the impure edge lives elsewhere. That boundary is the point: the defects this replaces
       are overwhelmingly cases where a FAILED READ was indistinguishable from a legitimate "no", and
       you cannot make that mistake in a function that cannot read anything.

       Ships nothing yet. Phase 1 is deliberately dead code with a live test suite: the 4,000 lines of
       bash it will replace are an incident log, and porting that log into named regression tests —
       BEFORE any of it is trusted in production — is the whole point of the phase. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- RestorePackagesWithLockFile, RestoreLockedMode and DisableImplicitLibraryPacksFolder (ADR-0006,
         ADR-0032) are INHERITED from the root Directory.Build.props, which imports the org-shared
         config this repo authors and ships. They were set here by hand only because .github did not
         consume its own build config (#609); it does now, so the lock-file and lock-hash rules reach
         this project the same way they reach every receiver. -->
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- `IsPackable` is false, but this assembly and its `.pdb` SHIP: `FS.GG.Coord.Cli` packs its
         whole output directory into `tools/net10.0/any/`, so both are entries under the
         `payloadSha256` the release saga compares. Without this property they embed the absolute
         directory the package happened to be built in, and the package is not path-independent no
         matter what the CLI project sets. .github#2688 measured six such entries across the three
         coord projects and fixed all six together; the route decision, the measurements, and the
         levers that do NOT work live in src/FS.GG.Coord.Cli/FS.GG.Coord.Cli.fsproj beside the same
         property. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ExitCode.fsi" />
    <Compile Include="ExitCode.fs" />
    <Compile Include="RepoScope.fsi" />
    <Compile Include="RepoScope.fs" />
    <!-- Operation (.github#2311, slice 1 of the 2026-08-04 executor-fencing design §11.2) opens NO
         sibling module — only System, System.Security.Cryptography and System.Text — so it is placed
         here, high in the list, deliberately: a module that depends on nothing must not become an
         ordering constraint on anything below it. Nothing compiled after it references it yet; slices
         2-6 are its first callers. This list has no globs, so a file that is not named here is not
         compiled at all. -->
    <Compile Include="Operation.fsi" />
    <Compile Include="Operation.fs" />
    <!-- RegistryPredicate is dependency-free (it opens no sibling module) and is compiled FIRST among
         the domain files so `Types.Item` can carry its `Verdict` — the ADR-0050 flip-time gate needs
         the predicate verdict as a resolved FACT on the item, the way `Blocker.State` is a fact, and a
         pure `Chore.derive` reads it (.github#1203). -->
    <Compile Include="RegistryPredicate.fsi" />
    <Compile Include="RegistryPredicate.fs" />
    <Compile Include="Intake.fsi" />
    <Compile Include="Intake.fs" />
    <Compile Include="IntakeReceipt.fsi" />
    <Compile Include="IntakeReceipt.fs" />
    <!-- FindingPacket (.github#2737) opens NO sibling module — only System, System.Text.Json and
         System.Text.RegularExpressions — so it constrains nothing below it and is placed here purely
         for readability, beside the intake types its `toIntakeSeed` feeds. It is the schema for the
         finding packet, which under .github#2695 is the SOLE INPUT to the sole filing authority.
         System.Text.Json is in the net10.0 shared framework, so this adds no PackageReference and
         `packages.lock.json` is unchanged. -->
    <Compile Include="FindingPacket.fsi" />
    <Compile Include="FindingPacket.fs" />
    <!-- ChurnReading (.github#2739) is the checkable skeleton beside the board-analyst's churn reading,
         and it sits here for the same reason FindingPacket does: it opens NO sibling module — only
         System, System.Globalization and System.Text.Json — so it constrains nothing below it, and the
         two schemas are neighbours because the packet is this reading's INPUT and .github#2739's route
         decision requires the pair to express the same sentinel idea the same way. System.Globalization
         and System.Text.Json are both in the net10.0 shared framework, so this adds no PackageReference
         and `packages.lock.json` is unchanged. This list has no globs: a file not named here is not
         compiled at all. -->
    <Compile Include="ChurnReading.fsi" />
    <Compile Include="ChurnReading.fs" />
    <Compile Include="DeliveryRoute.fsi" />
    <Compile Include="DeliveryRoute.fs" />
    <Compile Include="ReviewWait.fsi" />
    <Compile Include="ReviewWait.fs" />
    <Compile Include="StructuredDecision.fsi" />
    <Compile Include="StructuredDecision.fs" />
    <Compile Include="Types.fsi" />
    <Compile Include="Types.fs" />
    <Compile Include="Markdown.fsi" />
    <Compile Include="Markdown.fs" />
    <Compile Include="SemanticDiff.fsi" />
    <Compile Include="SemanticDiff.fs" />
    <Compile Include="TouchSet.fsi" />
    <Compile Include="TouchSet.fs" />
    <Compile Include="HumanBlock.fsi" />
    <Compile Include="HumanBlock.fs" />
    <!-- Class READS HumanBlock (an ADR-0045 `human/decision` sentinel is evidence of a `decision` class,
         .github#1588) rather than re-matching `Blocked on:` for itself, so it must compile after it. That
         edge is the whole of AC5: deriving the class from a line the board already carries, instead of
         adding a second line meaning the same thing. -->
    <Compile Include="Class.fsi" />
    <Compile Include="Class.fs" />
    <Compile Include="Kind.fsi" />
    <Compile Include="Kind.fs" />
    <Compile Include="Rooms.fsi" />
    <Compile Include="Rooms.fs" />
    <Compile Include="EpicBody.fsi" />
    <Compile Include="EpicBody.fs" />
    <Compile Include="Blockers.fsi" />
    <Compile Include="Blockers.fs" />
    <Compile Include="Schedulability.fsi" />
    <Compile Include="Schedulability.fs" />
    <Compile Include="Rank.fsi" />
    <Compile Include="Rank.fs" />
    <Compile Include="Protocol.fsi" />
    <Compile Include="Protocol.fs" />
    <Compile Include="Batch.fsi" />
    <Compile Include="Batch.fs" />
    <Compile Include="Driver.fsi" />
    <Compile Include="Driver.fs" />
    <Compile Include="CycleLedger.fsi" />
    <Compile Include="CycleLedger.fs" />
    <!-- Review (.github#2175) layers the typed, resumable review/repair protocol over Driver's existing
         marker-chain validator, and Delivery.fromReviewAcceptance folds its accepted-current-head
         receipt into Delivery's Snapshot — so it compiles after Driver and before Delivery. -->
    <Compile Include="Review.fsi" />
    <Compile Include="Review.fs" />
    <Compile Include="Delivery.fsi" />
    <Compile Include="Delivery.fs" />
    <!-- DriverEvents (.github#2135) layers a material-transition/active-inventory projection over
         Types/Driver/Delivery's existing vocabulary, so it compiles after all three. -->
    <Compile Include="DriverEvents.fsi" />
    <Compile Include="DriverEvents.fs" />
    <Compile Include="LifecycleProjection.fsi" />
    <Compile Include="LifecycleProjection.fs" />
    <Compile Include="Lanes.fsi" />
    <Compile Include="Lanes.fs" />
    <Compile Include="Landable.fsi" />
    <Compile Include="Landable.fs" />
    <Compile Include="Chore.fsi" />
    <Compile Include="Chore.fs" />
    <Compile Include="Kit.fsi" />
    <Compile Include="Kit.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

</Project>
