    <Compile Include="ReviewApplication.fs" />
    <Compile Include="CycleLedgerApplication.fsi" />
    <Compile Include="CycleLedgerApplication.fs" />
    <Compile Include="Identity.fsi" />
    <Compile Include="Identity.fs" />
    <Compile Include="RefParsing.fsi" />
    <Compile Include="RefParsing.fs" />
    <Compile Include="FollowupAudit.fsi" />
    <Compile Include="FollowupAudit.fs" />
    <Compile Include="Chores.fsi" />
    <Compile Include="Chores.fs" />
