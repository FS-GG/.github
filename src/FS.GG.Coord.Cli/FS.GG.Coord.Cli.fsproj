    <!-- AFTER `Client.fs`, deliberately: the follow-up queue reuses `parseRefIn` and the exit constants
         rather than growing a second answer to "what is a ref?" or "what does an empty look exit?" (#485).
         It is a LOCAL verb — no token, no board — and depends on `Client` for those two things only. -->
    <Compile Include="Followups.fsi" />
    <Compile Include="Followups.fs" />
    <Compile Include="IntakeApplication.fs" />
    <Compile Include="DeliveryRouteApplication.fsi" />
    <Compile Include="DeliveryRouteApplication.fs" />
    <Compile Include="Client.fs" />
    <Compile Include="SemanticDiffApplication.fs" />
    <Compile Include="Program.fs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Provider validator authority travels with the engine binary. Artifact roots are caller data;
         they must never select executable code (#2133 repair-phase round 1). The pinned byte digests
         in CycleLedgerApplication make an unreviewed validator replacement fail closed. -->
    <None Include="../../.agents/skills/work-roadmap/scripts/validate-critique-state.py"
          Link="provider-validators/validate-critique-state.py"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../.agents/skills/work-roadmap/scripts/validate-feedback-state.py"
          Link="provider-validators/validate-feedback-state.py"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FS.GG.Coord.Core/FS.GG.Coord.Core.fsproj" />
    <ProjectReference Include="../FS.GG.Coord.GitHub/FS.GG.Coord.GitHub.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
