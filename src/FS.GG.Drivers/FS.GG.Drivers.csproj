<!--
  FS.GG.Drivers — the `.github`-authored DRIVER skill bytes as ONE versioned package (ADR-0054
  §Byte-transport, resolving .github#1300; the ADR-0062 FS.GG.Kit pattern, one consumer over).

  WHAT THIS DELIVERS. `.github` authors a `scope: driver` skill class (ADR-0054) — a `.github`-authored,
  PRODUCT-materialized skill (the first is `work-roadmap`, ADR-0053/#1224). The scaffold-time materializer
  in the SDD CLI cannot reach `.github`: `fsgg-sdd scaffold` runs on an OFFLINE inner loop and generic SDD
  is barred from embedding a cross-repo source (FS.GG.SDD/CLAUDE.md, scaffold FR-002/SC-005). So `.github`
  PUBLISHES the driver bytes as a versioned package the CLI pins, restores at build/publish time (online),
  and materializes into a scaffold's skill roots at scaffold time (offline), with the ADR-0014
  content-addressed sha256 (from registry/driver-skill-manifest.json) as the integrity guarantee.

  WHY A SEPARATE PACKAGE FROM FS.GG.Kit. Same SUBSTRATE (ADR-0063: "reuse ADR-0062's substrate rather than
  invent a second one"), different CONSUMER and materialize point. FS.GG.Kit ships the coordination kit to
  the framework repos, materialized on the receiver's BUILD (ADR-0062). This ships driver skills to the
  SDD CLI, materialized into a scaffold at SCAFFOLD time (ADR-0054 names the edge: FS.GG.SDD.Cli → this
  package). Folding driver bytes into FS.GG.Kit would couple the SDD CLI to the whole coordination kit; a
  separate package keeps the dependency honest.

  NO CONSUMER MATERIALIZE TARGET, DELIBERATELY. FS.GG.Kit ships build/*.targets that materialize on the
  consumer's build. This package ships only build/FS.GG.Drivers.props — a stable handle to the packed
  content ($(FsggDriversContentDir)) — because the MATERIALIZE is the SDD CLI's, in F#, at scaffold time
  (ADR-0063: the materializer sources owner-repo bytes from a pinned, content-addressed channel). A
  package reference is not a materialized file (ADR-0062, ADR-0014); the materialize step lives downstream.

  DERIVED, NOT RESTATED (ADR-0058). This project packs no committed list of driver skills. stage-drivers.py
  reads registry/driver-skill-manifest.json — the ONE authored source, emitted by
  scripts/generate-driver-manifest — and stages exactly its `scope: driver` rows at pack time. A driver
  added/retired in the emitter needs no edit here.

  IDENTITY IS FOREVER (ADR-0003): PackageId FS.GG.Drivers is the product identity — never renamed in place.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A content-only package: it ships driver skill bytes + a content handle, no assembly. A TFM is
         still required for `dotnet pack`; net10.0 matches the repo's global.json floor. IncludeBuildOutput
         false means no lib/ folder is produced or packed. -->
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <IsPackable>true</IsPackable>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>FS.GG.Drivers</PackageId>
    <!-- 0.13.0 -> 0.14.0, a MINOR (.github#2136): drive/work-board host loops now consume a generated
         wave contract, so their machine literals cannot drift while qualitative judgement remains local. -->
    <!-- 0.15.0 -> 0.16.0, a MINOR (.github#2132): the release-train operator contract and its
         packaged manifest gain resumable typed release coordination while existing identities and
         package layout hold. The manifest bytes are receiver-visible even for operator-only rows. -->
    <!-- 0.16.0 -> 0.16.1, a PATCH (.github#2180): materialized board variants retain the same
         automatic repair-phase policy but no longer link across the package boundary to withheld
         operator-only bytes; package and consumer closure are now verified. -->
    <!-- 0.16.1 -> 0.17.0, a MINOR (.github#2135): the packed drive-board/work-board guidance no
         longer directs the host to detect material transitions and reconstruct the active-item
         inventory from memory — it now runs the coordination driver's events mode against a cursor
         file and forwards its two-line text projection verbatim. A receiver materializing this
         driver version picks up a new required reporting behaviour: the host stops composing status
         prose itself. Before this, no packed text named that command mode at all — this is new
         guidance, not a prose tidy of already-true text. Packed member set and destinations
         unchanged. -->
    <!-- 0.17.0 -> 0.18.0, a MINOR (.github#2175): the packed work-board guidance now instructs the
         host to cross-check the independent-review marker chain against the engine's typed
         review/repair protocol (`scripts/fsgg-coord review`) during verification, alongside the
         existing qualitative reading of the chain and materiality. A receiver materializing this
         driver version picks up new, receiver-visible host behaviour — not a rewording of an
         already-true description. drive-board is unaffected (operator scope; not packed here).
         Packed member set and destinations unchanged. -->
    <!-- 0.18.0 is now the LAST independent literal this project declares (.github#2402). FS.GG.Kit,
         FS.GG.Drivers and coord-engine (FS.GG.Coord.Cli) are a coherent set: one MSBuild property,
         $(FsggCoherentSetVersion) (Directory.Build.props), carries all three <Version> elements from
         here on, so a bump to one moves all three and the three cannot diverge from each other again.
         The set starts at 0.50.0 — one MINOR above FS.GG.Kit's prior 0.49.0, the highest of the
         three, and NOT 0.49.0 itself because that was already the newest FS.GG.Kit published on
         nuget.org (check-kit-published-coherence.py's PR arm requires strictly greater) — so
         adopting the shared scalar does not downgrade this package; it is a real, visible jump from
         0.18.0, made deliberately rather than silently (see docs/registry/compatibility.md). Future
         history for THIS package's own receiver-visible content still belongs in a comment here, same
         as always — only the literal moved, to Directory.Build.props. -->
    <!-- 0.68.0 -> 0.69.0, a coherent MINOR (.github#2807): the sibling coordination engine repairs
         fresh-claim ordinary-exhaustion authorization for advancing historical heads and strengthens
         its production refusal fences. Driver members, bytes, and destinations are unchanged; this
         project advances only because all three package versions share the coherent scalar. -->
    <!-- 0.69.0 -> 0.70.0, a coherent MINOR (.github#2801): the sibling engine and packed kit add
         executable mutual-overlap arbitration and single-board-orchestrator safety. Driver members,
         bytes, and destinations are unchanged; this project advances with the coherent scalar. -->
    <Version>$(FsggCoherentSetVersion)</Version>

    <Description>The .github-authored driver skill bytes (scope: driver, e.g. work-roadmap) as one versioned artifact, with registry/driver-skill-manifest.json as the content-addressed record. The SDD CLI pins it, restores it at build time, and materializes the driver into a scaffold's skill roots at scaffold time (ADR-0054, ADR-0062, ADR-0063; ADR-0014 verify).</Description>
    <Authors>FS-GG</Authors>
    <Company>FS-GG</Company>
    <PackageTags>fsgg;driver;skills;workroadmap;scaffold;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/FS-GG/.github</RepositoryUrl>
    <PackageProjectUrl>https://github.com/FS-GG/.github/tree/main/src/FS.GG.Drivers</PackageProjectUrl>

    <!-- NU5128: a package with no lib/ref assembly and no dependencies. That is exactly what a
         content-only driver package IS (SuppressDependenciesWhenPacking above), not a defect. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!-- Where the driver bytes are staged before packing: under obj/ (gitignored), regenerated every
         pack, so the derived set is never committed and cannot go stale. BaseIntermediateOutputPath (obj/)
         is resolved in the SDK props imported ABOVE this body; IntermediateOutputPath is not set until the
         SDK targets run (after the body), so using it here would evaluate empty and stage into src/. -->
    <DriversStagingDir>$(BaseIntermediateOutputPath)drivers-staging</DriversStagingDir>
  </PropertyGroup>

  <!-- Consumer-imported handle to the packed content (no materialize logic — that is the SDD CLI's), and
       the README, packed at the well-known paths NuGet auto-imports build/ from and reads the readme
       from. -->
  <ItemGroup>
    <None Include="build/FS.GG.Drivers.props" Pack="true" PackagePath="build/" />
    <None Include="README.md"                 Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Derive the packed driver set from registry/driver-skill-manifest.json at pack time, then add the
       staged files as package content. TargetsForTfmSpecificContentInPackage is NuGet's supported hook
       for COMPUTED package content — items added here land in the nupkg without being static <None> globs
       (which MSBuild evaluates before StageDrivers could have written anything). -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddDriversContent</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="StageDrivers" BeforeTargets="Pack">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/stage-drivers.py&quot; &quot;$(DriversStagingDir)&quot;" />
  </Target>

  <Target Name="AddDriversContent" DependsOnTargets="StageDrivers">
    <ItemGroup>
      <_DriversStaged Include="$(DriversStagingDir)/**/*" />
      <!-- Constant folder PackagePath: NuGet appends each glob item's RecursiveDir-relative path
           (driver-skill-manifest.json, skills/work-roadmap/SKILL.md, …) under drivers/. -->
      <TfmSpecificPackageFile Include="@(_DriversStaged)">
        <PackagePath>drivers/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
