    <Version>$(FsggCoherentSetVersion)</Version>

    <Description>FS-GG coordination kit as one versioned artifact — the shared coordination skills and the fsgg-coord/skill-view client shims, derived from registry/repos.yml. Receivers reference it and materialize the skills onto disk (ADR-0062) instead of byte-copying the kit (ADR-0058: derive, don't restate).</Description>
    <Authors>FS-GG</Authors>
    <Company>FS-GG</Company>
    <PackageTags>fsgg;coordination;kit;skills;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/FS-GG/.github</RepositoryUrl>
    <PackageProjectUrl>https://github.com/FS-GG/.github/tree/main/src/FS.GG.Kit</PackageProjectUrl>

    <!-- NU5128: a package with no lib/ref assembly and no dependencies. That is exactly what a
         content-only kit package IS (SuppressDependenciesWhenPacking above), not a defect. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!-- Where the kit is staged before packing: under obj/ (gitignored), regenerated every pack, so
         the derived set is never committed and cannot go stale. BaseIntermediateOutputPath (obj/) is
         resolved in the SDK props imported ABOVE this body; IntermediateOutputPath is not set until the
         SDK targets run (after the body), so using it here would evaluate empty and stage into src/. -->
    <KitStagingDir>$(BaseIntermediateOutputPath)kit-staging</KitStagingDir>
  </PropertyGroup>

  <!-- Consumer-imported build logic (the materialize + verify contract) and the README, packed at the
       well-known paths NuGet auto-imports build/ from and reads the readme from. -->
  <ItemGroup>
    <None Include="build/FS.GG.Kit.props"   Pack="true" PackagePath="build/" />
    <None Include="build/FS.GG.Kit.targets" Pack="true" PackagePath="build/" />
    <None Include="README.md"               Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Derive the packed kit from registry/repos.yml at pack time, then add the staged files as package
       content. TargetsForTfmSpecificContentInPackage is NuGet's supported hook for COMPUTED package
       content — items added here land in the nupkg without being static <None> globs (which MSBuild
       evaluates before StageKit could have written anything). -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddKitContent</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="StageKit" BeforeTargets="Pack">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/stage-kit.sh&quot; &quot;$(KitStagingDir)&quot;" />
  </Target>

  <Target Name="AddKitContent" DependsOnTargets="StageKit">
    <ItemGroup>
      <_KitStaged Include="$(KitStagingDir)/**/*" />
      <!-- Constant folder PackagePath: NuGet appends each glob item's RecursiveDir-relative path
           (skills/check-board/SKILL.md, client/fsgg-coord, …) under kit/. Naming the folder rather than
           the file also sidesteps NuGet reading an extension-less destination (the fsgg-coord client)
           as a directory and doubling the path onto it. -->
      <TfmSpecificPackageFile Include="@(_KitStaged)">
        <PackagePath>kit/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
