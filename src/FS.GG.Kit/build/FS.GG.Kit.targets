<Project>

  <!--
    FS.GG.Kit materialize + verify (ADR-0062, ADR-0014). Auto-imported by NuGet from the package's
    build/ folder. A package reference is not a file on disk, but the agent harness loads skills as
    real files (ADR-0011) and `scripts/fsgg-coord` must be executable — so a receiver MATERIALIZES the
    packaged kit onto disk. This is the load-bearing half of ADR-0062: getting it wrong would trade a
    loud sync PR for a SILENTLY missing skill, so the materialize is content-addressed and fails LOUD.

    The packed kit sits beside this file at ../kit/, described by ../kit/kit-manifest.tsv
    (kind <TAB> package-rel path <TAB> receiver dest <TAB> sha256 [<TAB> executable]). MaterializeKit copies each entry to
    its receiver destination(s), verifies the bytes against the recorded sha256, and ERRORS on a missing
    or mismatched file rather than skipping it. The coordination kit (skill/client/config) always
    materializes; the build-config capability is opt-in (IncludeBuildConfig).
  -->

  <PropertyGroup>
    <FsggKitDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../kit'))</FsggKitDir>
  </PropertyGroup>

  <UsingTask TaskName="MaterializeKit" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$([MSBuild]::NormalizePath('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))">
    <Task>
      <Code Type="Class" Language="cs">
        <![CDATA[
        using System;
        using System.Collections.Generic;
        using System.IO;
        using System.Security.Cryptography;
        using Microsoft.Build.Framework;
        using Microsoft.Build.Utilities;

        public class MaterializeKit : Task
        {
            public string KitDir { get; set; }
            public string ReceiverRoot { get; set; }
            public string SkillRoots { get; set; }

            // Roots this contract USED to declare and no longer does, ';'-separated (ADR-0065 as
            // amended by ADR-0067 §5, .github#1636).
            //
            // WITHOUT THIS THE RETIREMENT CANNOT REACH A RECEIVER. The stale-file sweep below only
            // visits directories the manifest still maps into, so dropping a root from SkillRoots
            // makes the materializer STOP LOOKING at it — the retired copies would survive every
            // future materialize, orphaned but present, and Codex would keep cataloging them. A
            // receiver would then have to delete the tree BY HAND, which is exactly what ADR-0065's
            // transport contract forbids and what this item's acceptance criterion 3 rules out.
            //
            // Scope is deliberately narrow: only skill directories the CURRENT manifest declares are
            // removed, so a receiver's OWN skill under a retired root is left alone (and the root
            // then stays, non-empty, which is the correct outcome — it is no longer ours to police).
            public string RetiredSkillRoots { get; set; }

            // Roots that are STILL declared runtime roots but whose content is GENERATED locally
            // (`scripts/skill-view generate`) rather than materialized here — ';'-separated
            // (ADR-0065 §Retiring a root as amended, ADR-0067 §6, .github#1696). Empty by default.
            //
            // WHY THIS IS NOT `RetiredSkillRoots` UNDER ANOTHER NAME, even though the sweep below
            // treats them alike. A retired root LEAVES the runtime contract; a view root STAYS in
            // it. The materializer's behaviour coincides — neither is copied into, both are swept —
            // and every OTHER reader's behaviour diverges: `.agent-skill-roots`,
            // `Fsgg.Schemas.agentSkillRoots`, `coordination-sync` and `KitDigest` must keep counting
            // a view root and must stop counting a retired one. Spelling them the same property
            // would make the kit assert something false about the runtime surface in order to reuse
            // eight lines of deletion.
            //
            // WHY A SWEEP AT ALL. A receiver's second root is COMMITTED today. `scripts/skill-view`
            // refuses to generate over a root git tracks, with no override (skill-view:331), and
            // ADR-0065 forbids the receiver hand-deleting the mirror. The materializer that created
            // those copies is the only thing permitted to remove them, so it is the thing that does.
            public string ViewSkillRoots { get; set; }

            // The build-config capability (Directory.Build.props / Directory.Packages.props) reaches
            // only 4 of the receivers and .github imports rather than copies it, so it is OPT-IN: a
            // consumer that wants it sets FsggKitMaterializeBuildConfig=true. Off, build-config rows are
            // skipped; the coordination kit always materializes.
            public bool IncludeBuildConfig { get; set; }

            // Hand-authored-file safety (.github#387), mirroring sync-build-config.sh. A canonical
            // build-config .props carries MARKER; a hand-authored repo file does not. First-time adoption
            // (FsggKitAdoptBuildConfig=true) moves a pre-existing UNMARKED .props to *.local.props — which
            // the canonical file <Import>s — so repo-specific settings survive the takeover. Off (the
            // default), the task REFUSES to overwrite an unmarked .props rather than silently clobber it.
            // This gate is build-config only: the coordination kit (skills/client/config) is distributed,
            // content-addressed content nobody hand-authors, so its overwrite stays unconditional.
            public bool AdoptBuildConfig { get; set; }

            // A canonical synced .props carries this exact string (see dist/dotnet/Directory.Build.props);
            // it is the same marker sync-build-config.sh keys its refusal on, so the two tools agree on
            // what "hand-authored" means.
            const string Marker = "Source of truth: FS-GG/.github";

            [Output] public ITaskItem[] ClientFiles { get; set; }
            [Output] public ITaskItem[] NonClientFiles { get; set; }

            static string Sha256Hex(string path)
            {
                using (var sha = SHA256.Create())
                using (var fs = File.OpenRead(path))
                    return BitConverter.ToString(sha.ComputeHash(fs)).Replace("-", "").ToLowerInvariant();
            }

            static bool CarriesMarker(string path)
            {
                return File.Exists(path) && File.ReadAllText(path).Contains(Marker);
            }

            public override bool Execute()
            {
                var manifest = Path.Combine(KitDir, "kit-manifest.tsv");
                if (!File.Exists(manifest))
                {
                    Log.LogError("FS.GG.Kit: kit-manifest.tsv not found under " + KitDir + " — the package is malformed.");
                    return false;
                }

                var roots = new List<string>();
                foreach (var r in (SkillRoots ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
                    roots.Add(r.Trim());

                var retiredRoots = new List<string>();
                foreach (var r in (RetiredSkillRoots ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
                {
                    var t = r.Trim();
                    // A root cannot be both live and retired; the live set wins and the entry is ignored.
                    if (t.Length > 0 && !roots.Contains(t)) retiredRoots.Add(t);
                }

                // VIEW ROOTS, and their conflicts are REFUSED rather than resolved. The retired set
                // above lets the live set win silently, which is safe there because both readings
                // end with the kit's skills present at that path. Here they do not: reading a view
                // root as live MATERIALIZES committed copies into a path the receiver has arranged
                // to be a generated symlink, and reading a live root as a view DELETES the only
                // copies it has. There is no defensible default between those, so a root named in
                // two dispositions is a receiver configuration error and is named as one.
                var viewRoots = new List<string>();
                foreach (var r in (ViewSkillRoots ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
                {
                    var t = r.Trim();
                    if (t.Length == 0) continue;
                    if (roots.Contains(t))
                    {
                        Log.LogError("FS.GG.Kit: '" + t + "' is declared in BOTH FsggKitSkillRoots and " +
                            "FsggKitViewSkillRoots. A root is either materialized into or generated as a view, " +
                            "never both — remove it from one (ADR-0065 §Retiring a root, .github#1696).");
                        continue;
                    }
                    if (retiredRoots.Contains(t))
                    {
                        Log.LogError("FS.GG.Kit: '" + t + "' is declared in BOTH FsggKitRetiredSkillRoots and " +
                            "FsggKitViewSkillRoots. A retired root LEAVES the runtime contract and a view root " +
                            "STAYS in it; they cannot both be true of one path (ADR-0065 §Retiring a root, .github#1696).");
                        continue;
                    }
                    viewRoots.Add(t);
                }
                // RETURN BEFORE TOUCHING THE TREE. A contradictory root set is not a finding to
                // report alongside a completed materialize: under one reading of it this task copies
                // into a path the receiver arranged to be a link, writing THROUGH that link into the
                // very source the view resolves to. Falling through to the manifest loop and failing
                // afterwards would do the damage and then complain about it.
                if (Log.HasLoggedErrors) return false;

                var clients = new List<ITaskItem>();
                var nonClients = new List<ITaskItem>();
                var managedSkillDirs = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
                var kitSkillNames = new HashSet<string>(StringComparer.Ordinal);
                int copied = 0, verified = 0;

                foreach (var raw in File.ReadAllLines(manifest))
                {
                    var line = raw.Trim();
                    if (line.Length == 0) continue;
                    var f = line.Split('\t');
                    if (f.Length != 4 && f.Length != 5)
                    {
                        Log.LogError("FS.GG.Kit: malformed manifest row (want 4 legacy or 5 v2 tab-separated fields): " + line);
                        continue;
                    }
                    string kind = f[0], pkgRel = f[1], receiverDest = f[2], want = f[3].ToLowerInvariant();
                    bool executable;
                    if (f.Length == 4)
                        executable = kind == "client"; // v1 compatibility during publish-before-flip.
                    else if (!Boolean.TryParse(f[4], out executable))
                    {
                        Log.LogError("FS.GG.Kit: malformed executable field in manifest row: " + line);
                        continue;
                    }

                    // build-config is opt-in (see IncludeBuildConfig): skip it unless the consumer asked.
                    if (kind == "build-config" && !IncludeBuildConfig) continue;

                    var src = Path.Combine(KitDir, pkgRel.Replace('/', Path.DirectorySeparatorChar));
                    if (!File.Exists(src))
                    {
                        Log.LogError("FS.GG.Kit: packaged kit file missing: " + pkgRel + " — cannot materialize " + receiverDest + ".");
                        continue;
                    }
                    var srcHash = Sha256Hex(src);
                    if (!string.Equals(srcHash, want, StringComparison.OrdinalIgnoreCase))
                    {
                        Log.LogError("FS.GG.Kit: package integrity — " + pkgRel + " sha256 " + srcHash + " != manifest " + want + ".");
                        continue;
                    }

                    var dests = new List<string>();
                    if (kind == "skill")
                    {
                        // The skill's own top-level directory name, which is what a retired root holds
                        // a copy of. Recorded from the manifest — AFTER the existence and sha256 checks
                        // above, so only a row this package really carries can ever name a deletion —
                        // so the sweep below removes only what the kit itself put there.
                        //
                        // `.`/`..` are REFUSED rather than normalized. A manifest destination that
                        // escapes its root is a producer defect the copy path already treats as one,
                        // but here the consequence is a recursive DELETE outside the retired root, so
                        // it is rejected explicitly instead of relying on that.
                        var normalizedDest = receiverDest.Replace('\\', '/');
                        var slash = normalizedDest.IndexOf('/');
                        var skillName = slash < 0 ? normalizedDest : normalizedDest.Substring(0, slash);
                        if (skillName.Length > 0 && skillName != "." && skillName != "..")
                            kitSkillNames.Add(skillName);
                    }
                    if (kind == "skill")
                        foreach (var root in roots)
                            dests.Add(Path.Combine(ReceiverRoot, root, receiverDest.Replace('/', Path.DirectorySeparatorChar)));
                    else
                        dests.Add(Path.Combine(ReceiverRoot, receiverDest.Replace('/', Path.DirectorySeparatorChar)));

                    foreach (var dest in dests)
                    {
                        Directory.CreateDirectory(Path.GetDirectoryName(dest));
                        if (kind == "skill")
                        {
                            var normalized = receiverDest.Replace('/', Path.DirectorySeparatorChar);
                            var firstSeparator = normalized.IndexOf(Path.DirectorySeparatorChar);
                            var skillDir = dest;
                            var relativeWithinSkill = firstSeparator < 0 ? "" : normalized.Substring(firstSeparator + 1);
                            foreach (var ignored in relativeWithinSkill.Split(
                                new[] { Path.DirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries))
                                skillDir = Path.GetDirectoryName(skillDir);
                            HashSet<string> expected;
                            if (!managedSkillDirs.TryGetValue(skillDir, out expected))
                            {
                                expected = new HashSet<string>(StringComparer.Ordinal);
                                managedSkillDirs.Add(skillDir, expected);
                            }
                            expected.Add(Path.GetFullPath(dest));
                        }

                        // Hand-authored-file safety (.github#387) — build-config .props only. An existing
                        // dest that does NOT carry the marker was written by the receiver, not by a prior
                        // sync/materialize, so overwriting it would destroy their settings.
                        if (kind == "build-config" && File.Exists(dest) && !CarriesMarker(dest))
                        {
                            var localDest = dest.EndsWith(".props", StringComparison.OrdinalIgnoreCase)
                                ? dest.Substring(0, dest.Length - ".props".Length) + ".local.props"
                                : dest + ".local";
                            if (!AdoptBuildConfig)
                            {
                                Log.LogError("FS.GG.Kit: refusing to overwrite hand-authored " + dest +
                                    " (no '" + Marker + "' marker). Set FsggKitAdoptBuildConfig=true once to move it to " +
                                    Path.GetFileName(localDest) + " (imported by the canonical file), or remove it first.");
                                continue;
                            }
                            if (File.Exists(localDest))
                            {
                                // Both a hand-authored dest and a pre-existing *.local.props exist. Moving
                                // dest onto localDest would destroy the latter; fall-through would destroy
                                // the former. Refuse — fail-closed, exactly as sync-build-config.sh --adopt.
                                Log.LogError("FS.GG.Kit: refusing to adopt " + dest + ": a hand-authored " +
                                    Path.GetFileName(dest) + " and " + Path.GetFileName(localDest) + " both exist. Merge the " +
                                    "settings you want into " + Path.GetFileName(localDest) + ", delete " + Path.GetFileName(dest) +
                                    ", then re-materialize.");
                                continue;
                            }
                            File.Move(dest, localDest);
                            Log.LogMessage(MessageImportance.High, "FS.GG.Kit: adopted " + Path.GetFileName(dest) +
                                " -> " + Path.GetFileName(localDest) + " (hand-authored settings preserved via import).");
                        }

                        if (!File.Exists(dest) || !string.Equals(Sha256Hex(dest), want, StringComparison.OrdinalIgnoreCase))
                        {
                            File.Copy(src, dest, true);
                            copied++;
                        }
                        var got = Sha256Hex(dest);
                        if (!string.Equals(got, want, StringComparison.OrdinalIgnoreCase))
                        {
                            Log.LogError("FS.GG.Kit: materialized " + dest + " sha256 " + got + " != " + want + ".");
                            continue;
                        }
                        verified++;
                        if (executable) clients.Add(new TaskItem(dest));
                        else nonClients.Add(new TaskItem(dest));
                    }
                }

                // A skill directory is a closed transport unit. Remove stale files left by an older
                // package so a deleted reference or metadata file cannot survive a successful restore.
                foreach (var pair in managedSkillDirs)
                {
                    if (!Directory.Exists(pair.Key)) continue;
                    foreach (var existing in Directory.GetFiles(pair.Key, "*", SearchOption.AllDirectories))
                    {
                        if (pair.Value.Contains(Path.GetFullPath(existing))) continue;
                        File.Delete(existing);
                        copied++;
                        Log.LogMessage(MessageImportance.High, "FS.GG.Kit: removed undeclared skill file " + existing + ".");
                    }
                }

                // RETIRED ROOTS. A root this contract no longer declares still holds the copies an
                // OLDER package wrote. The loop above cannot reach them — it only walks `roots` — so
                // the retirement is completed here, by the materializer, on the receiver's next
                // restore. This is the mechanism that lets ADR-0065's "never delete a mirror by hand"
                // and ADR-0067 §5's "the third root goes away" both be true at once.
                //
                // ONLY ON A CLEAN MATERIALIZE. If anything above failed — a missing packaged file, a
                // sha256 mismatch, a refused hand-authored .props — the receiver does NOT yet have the
                // copies that replace these, and removing the old ones would turn a loud, recoverable
                // failure into a tree with no skills in any root. Deleting last year's copy is only
                // safe once this year's is verifiably on disk.
                if (!Log.HasLoggedErrors)
                {
                foreach (var retired in retiredRoots)
                {
                    var retiredRootDir = Path.Combine(ReceiverRoot, retired.Replace('/', Path.DirectorySeparatorChar));
                    if (!Directory.Exists(retiredRootDir)) continue;
                    foreach (var skillName in kitSkillNames)
                    {
                        var stale = Path.Combine(retiredRootDir, skillName);
                        if (!Directory.Exists(stale)) continue;
                        // A SYMLINKED entry is unlinked, never recursed into. Phase 2 (.github#1635)
                        // makes a runtime root a generated view, so a retired root may legitimately be
                        // a link to a tree that is still live — and a recursive delete through it would
                        // destroy the canonical source instead of the copy.
                        var info = new DirectoryInfo(stale);
                        if ((info.Attributes & FileAttributes.ReparsePoint) != 0)
                        {
                            info.Delete();
                            Log.LogMessage(MessageImportance.High,
                                "FS.GG.Kit: unlinked retired skill root view " + stale + " (ADR-0067 §5).");
                            continue;
                        }
                        Directory.Delete(stale, true);
                        Log.LogMessage(MessageImportance.High,
                            "FS.GG.Kit: removed retired skill root copy " + stale + " (ADR-0067 §5).");
                    }
                    // Only if nothing of the receiver's own is left. A surviving entry is theirs, not
                    // ours, and removing the directory around it would be the hand-deletion this whole
                    // mechanism exists to avoid.
                    if (Directory.GetFileSystemEntries(retiredRootDir).Length == 0)
                    {
                        Directory.Delete(retiredRootDir);
                        Log.LogMessage(MessageImportance.High,
                            "FS.GG.Kit: removed now-empty retired skill root " + retiredRootDir + ".");
                    }
                }

                // VIEW ROOTS (.github#1696). Same deletion, a different reason, and one guard the
                // retired sweep does not need.
                //
                // The retirement this completes is of the COPY, not of the root: the path stays a
                // declared runtime root and `scripts/skill-view generate` will put a view there. The
                // materializer removes the committed copies because it wrote them and because
                // ADR-0065 forbids the receiver removing them by hand — and because until they are
                // gone `skill-view:331` refuses to generate over a root git still tracks. Removing
                // the now-empty root directory is likewise required and not tidiness: `generate`
                // refuses to REPLACE a directory that is neither a symlink nor carries its own
                // `.skill-view` receipt, so an empty leftover would block the very view it is
                // waiting for.
                //
                // THE GUARD. A view root that has ALREADY been generated is a symlink to the live
                // source (or, where the filesystem refuses one, a copy carrying a `.skill-view`
                // receipt). Sweeping either would be a catastrophe rather than a no-op: through the
                // symlink, `Directory.Delete(stale, true)` would recurse into `.claude/skills` and
                // destroy the canonical tree the view is a view OF. So a root that is already a view
                // is left entirely alone — there is nothing of ours under it to remove, and what is
                // under it is the source. (The retired sweep guards the same hazard one level down,
                // at the individual skill entry; here the ROOT itself is the link, so the guard has
                // to be one level up.)
                foreach (var view in viewRoots)
                {
                    var viewRootDir = Path.Combine(ReceiverRoot, view.Replace('/', Path.DirectorySeparatorChar));
                    if (!Directory.Exists(viewRootDir)) continue;
                    var viewInfo = new DirectoryInfo(viewRootDir);
                    if ((viewInfo.Attributes & FileAttributes.ReparsePoint) != 0)
                    {
                        Log.LogMessage(MessageImportance.Low,
                            "FS.GG.Kit: view skill root " + viewRootDir + " is a generated link — not swept.");
                        continue;
                    }
                    if (File.Exists(Path.Combine(viewRootDir, ".skill-view")))
                    {
                        Log.LogMessage(MessageImportance.Low,
                            "FS.GG.Kit: view skill root " + viewRootDir + " carries a .skill-view receipt — not swept.");
                        continue;
                    }
                    foreach (var skillName in kitSkillNames)
                    {
                        var stale = Path.Combine(viewRootDir, skillName);
                        if (!Directory.Exists(stale)) continue;
                        var info = new DirectoryInfo(stale);
                        if ((info.Attributes & FileAttributes.ReparsePoint) != 0)
                        {
                            info.Delete();
                            Log.LogMessage(MessageImportance.High,
                                "FS.GG.Kit: unlinked stale view at " + stale + " (.github#1696).");
                            continue;
                        }
                        Directory.Delete(stale, true);
                        Log.LogMessage(MessageImportance.High,
                            "FS.GG.Kit: removed materialized copy " + stale + " — this root is now a generated view (.github#1696).");
                    }
                    // Only if nothing of the receiver's own is left, exactly as above. A surviving
                    // entry is theirs; and it is also a problem they must resolve, because
                    // `skill-view generate` cannot put a view where their directory stands. The
                    // §8 assertion below says so in those words rather than this loop guessing.
                    if (Directory.GetFileSystemEntries(viewRootDir).Length == 0)
                    {
                        Directory.Delete(viewRootDir);
                        Log.LogMessage(MessageImportance.High,
                            "FS.GG.Kit: removed now-empty view skill root " + viewRootDir +
                            " — generate the view with: scripts/skill-view generate --source <live root>");
                    }
                }
                }

                ClientFiles = clients.ToArray();
                NonClientFiles = nonClients.ToArray();
                // A floor, not decoration: an EMPTY or truncated-to-zero manifest would otherwise
                // materialize nothing and report success — a silently missing kit, the one failure mode
                // ADR-0062 exists to rule out. The producer guards this too (stage-kit.sh), but the
                // consumer-side task is where the load-bearing guarantee is asserted, so it holds the
                // line independently.
                if (verified == 0 && !Log.HasLoggedErrors)
                    Log.LogError("FS.GG.Kit: kit-manifest.tsv named no files to materialize — the package is malformed or truncated.");

                if (!Log.HasLoggedErrors)
                    Log.LogMessage(MessageImportance.High,
                        "FS.GG.Kit: materialized " + verified + " file(s) (" + copied + " written) into " + ReceiverRoot + ".");
                return !Log.HasLoggedErrors;
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!--
    ADR-0067 §8's LOUD ABSENCE CHECK, over the roots nothing else can vouch for (.github#1696).

    WHY THIS TASK HAS TO EXIST AT ALL. Every root MaterializeKit copies into is verified file by file
    against the manifest's sha256 — that is ADR-0062's load-bearing half, and it is why a materialize
    failure is loud today. A VIEW root gets none of that, by construction: the kit deliberately does
    not write it, so the kit would have nothing to say when it is empty, dangling, or a Windows
    text-file symlink. Phase 1 measured all three of those as **exit 0 with no diagnostic in BOTH
    runtimes** (Claude Code 2.1.220, Codex CLI 0.145.0) — an agent that quietly has no skills. ADR-0067
    §8 is explicit about the trade: *"a rewrite that removes the loud failure and adds the quiet one is
    worse than no rewrite."* Introducing the view-root disposition without this check WOULD be that
    rewrite. So it ships in the same change, and it is an ERROR, not a warning.

    IT IS SCOPED TO VIEW ROOTS, deliberately. Live roots are already covered, per file and per byte,
    by the materialize itself; re-asserting them here would be a second gate answering a question that
    already has an owner. With no view roots declared — the default — there is nothing this can say,
    and it says so rather than reporting a pass it did not earn.

    THE EXPECTED SET IS THE PACKAGE'S OWN MANIFEST, never a directory listing of the root being
    judged. Deriving "what should be visible" from what IS visible is the vacuous-pass shape (epic
    #266): an empty view root would then satisfy itself. It is also not a SUBSET manifest — this is
    every skill file the kit ships, which is exactly the set the kit is answerable for, and a
    receiver's own skills are not policed because they were never the kit's to deliver.
  -->
  <UsingTask TaskName="CheckSkillView" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$([MSBuild]::NormalizePath('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))">
    <Task>
      <Code Type="Class" Language="cs">
        <![CDATA[
        using System;
        using System.Collections.Generic;
        using System.IO;
        using Microsoft.Build.Framework;
        using Microsoft.Build.Utilities;

        public class CheckSkillView : Task
        {
            public string KitDir { get; set; }
            public string ReceiverRoot { get; set; }
            public string ViewSkillRoots { get; set; }

            public override bool Execute()
            {
                var viewRoots = new List<string>();
                foreach (var r in (ViewSkillRoots ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
                {
                    var t = r.Trim();
                    if (t.Length > 0) viewRoots.Add(t);
                }
                if (viewRoots.Count == 0)
                {
                    // Not a pass — an absence of subject. Said out loud so that a receiver who wired
                    // this target and expected it to be watching something is not reassured by silence.
                    Log.LogMessage(MessageImportance.High,
                        "FS.GG.Kit: no view skill roots declared (FsggKitViewSkillRoots is empty) — nothing to assert.");
                    return true;
                }

                var manifest = Path.Combine(KitDir, "kit-manifest.tsv");
                if (!File.Exists(manifest))
                {
                    Log.LogError("FS.GG.Kit: kit-manifest.tsv not found under " + KitDir + " — the package is malformed.");
                    return false;
                }

                // Every skill file the kit ships, receiver-relative WITHIN a root.
                var expected = new List<string>();
                foreach (var raw in File.ReadAllLines(manifest))
                {
                    var line = raw.Trim();
                    if (line.Length == 0) continue;
                    var f = line.Split('\t');
                    if (f.Length < 4 || f[0] != "skill") continue;
                    expected.Add(f[2].Replace('/', Path.DirectorySeparatorChar));
                }
                // "I found nothing to look for" and "everything I looked for is there" are opposite
                // facts, and only one of them is a pass (epic #266, and skill-view's own rule).
                if (expected.Count == 0)
                {
                    Log.LogError("FS.GG.Kit: kit-manifest.tsv names no skill files — refusing to certify a view root " +
                        "against an EMPTY expected set, which every root would satisfy.");
                    return false;
                }

                foreach (var view in viewRoots)
                {
                    var dir = Path.Combine(ReceiverRoot, view.Replace('/', Path.DirectorySeparatorChar));

                    // The three silent classes phase 1 measured, named SEPARATELY — a diagnostic that
                    // names the wrong cause sends the reader to the wrong repair.
                    if (!Directory.Exists(dir))
                    {
                        if (File.Exists(dir))
                            Log.LogError("FS.GG.Kit: view skill root '" + view + "' is a FILE, not a directory. " +
                                "This is what a COMMITTED symlink looks like after `git -c core.symlinks=false` " +
                                "checkout (the git-for-Windows default without Developer Mode) — the body is the " +
                                "link target as text. Both runtimes resolve ZERO skills here and exit 0 saying " +
                                "nothing. Delete it and run: scripts/skill-view generate --source <live root>");
                        else
                            Log.LogError("FS.GG.Kit: view skill root '" + view + "' is ABSENT or a DANGLING link. " +
                                "The view was never generated, or its target moved, so this runtime resolves ZERO " +
                                "skills and exits 0 while doing it (ADR-0067 §8). Run: " +
                                "scripts/skill-view generate --source <live root>");
                        continue;
                    }

                    var missing = new List<string>();
                    foreach (var rel in expected)
                        if (!File.Exists(Path.Combine(dir, rel))) missing.Add(rel.Replace(Path.DirectorySeparatorChar, '/'));

                    if (missing.Count == 0)
                    {
                        Log.LogMessage(MessageImportance.High,
                            "FS.GG.Kit: view skill root '" + view + "' — all " + expected.Count + " kit skill file(s) visible.");
                        continue;
                    }

                    // Bounded, because the interesting fact is WHICH class of failure this is, and a
                    // wholly ungenerated view would otherwise print the entire kit.
                    var shown = Math.Min(missing.Count, 10);
                    var list = string.Join(", ", missing.GetRange(0, shown).ToArray());
                    Log.LogError("FS.GG.Kit: view skill root '" + view + "' exists but " + missing.Count + " of " +
                        expected.Count + " kit skill file(s) are NOT visible there: " + list +
                        (missing.Count > shown ? ", …" : "") +
                        ". A partly-visible root is the same silent failure as an empty one — the runtime " +
                        "loads what it finds and reports nothing. Regenerate the view: " +
                        "scripts/skill-view generate --source <live root>  (if the root holds the receiver's own " +
                        "directories, `generate` cannot replace it — move them under the live root first).");
                }

                return !Log.HasLoggedErrors;
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- WHAT A MATERIALIZE DOES TO A DIVERGENT RECEIVER, MEASURED BY MUTATION RATHER THAN READ OFF THIS
       FILE (.github#1834, 2026-07-28, on a throwaway clone of FS.GG.SDD at its own pin, FS.GG.Kit
       0.18.0). This table had been READ out of the code three times and restated; each row below was
       reproduced by breaking a real receiver tree and running both mechanisms. Anchors are file
       sha256 on disk — never this task's own log — and every leg carries an unmutated control plus a
       refutation leg proving the gate can still red (#1808's four-point specification, #266).

         divergence                              next materialize      `kit / coordination-kit`
         ..........................................................................................
         a materialized file hand-edited         OVERWRITTEN (1 wrtn)  RED  `DRIFT (differs): <path>`
         a stray file in a managed skill dir     DELETED               RED  `DRIFT (extra): <path>`
         the kit drops a skill/config ROW        ORPHANED, untouched   GREEN, and still green when
                                                                      the orphan is then CORRUPTED

       The third row is the one that matters and it was reproduced TWICE, once without any synthetic
       input: 0.17.0 -> 0.18.0 really did drop `.config/dotnet-tools.json` (#1615/ADR-0068), the graded
       set went 28 -> 27, and the file it stopped declaring was neither deleted nor restored nor graded
       thereafter. The skill-row half needed a package that never shipped, so a local 0.18.0 with one
       skill's five rows removed was built for it: the whole `.claude/skills/<id>/` directory survived,
       the closed-transport-unit sweep logged ZERO removals because it only walks directories the
       manifest still maps into, and the gate stayed green on a corrupted file inside it.

       SO THE TWO CLASSES THE GATE CATCHES ARE EXACTLY THE TWO A MATERIALIZE WOULD HAVE ERASED, and the
       one it misses is the one nothing erases. That is not a defect in the gate — `coordination-sync`
       in its pinned check mode grades DECLARED files against the pin, and an orphan is by
       construction no longer declared. It is the reason `RetiredSkillRoots` exists, and the reason a
       dropped ROW (as opposed to a dropped ROOT, which the retirement sweep below does complete) has
       no automatic remedy at all.

       AND "AT THE NEXT MATERIALIZE" IS NOT "SOON", WHICH IS THE HALF A READER GUESSES WRONG. The
       receivers' `kit-materialize.yml` callers trigger on `pull_request` ALONE — no `workflow_dispatch`
       in any of the seven — and the materialize job is further gated to `renovate/*` same-repo head
       refs. Across 842 runs in seven receivers, ZERO ran on `main`. A divergence committed to `main` is
       therefore never healed on `main`; it is healed only when a Renovate branch carrying it is
       materialized and that pull request merges. Measured interval between merged `renovate/*` pull
       requests: mean 27-84h, p90 70-265h, max 167-312h (7-13 DAYS), and two receivers had too few to
       measure at all. The detector runs 9-69 times a DAY in the same repos. Do not describe this
       materializer as self-healing without that ratio attached. -->

  <!-- Public entry point. Invoke explicitly (`dotnet build -t:FsggKitMaterialize`) or let it run as part
       of the consumer's build (FsggKitMaterializeOnBuild, default true). -->
  <Target Name="FsggKitMaterialize">
    <MaterializeKit KitDir="$(FsggKitDir)" ReceiverRoot="$(FsggKitReceiverRoot)" SkillRoots="$(FsggKitSkillRoots)"
                    RetiredSkillRoots="$(FsggKitRetiredSkillRoots)" ViewSkillRoots="$(FsggKitViewSkillRoots)"
                    IncludeBuildConfig="$(FsggKitMaterializeBuildConfig)" AdoptBuildConfig="$(FsggKitAdoptBuildConfig)">
      <Output TaskParameter="ClientFiles" ItemName="_FsggKitClient" />
      <Output TaskParameter="NonClientFiles" ItemName="_FsggKitNonClient" />
    </MaterializeKit>
    <!-- NuGet extraction can make every global-packages-cache file executable on Unix even when the
         nupkg records mode 0644. File.Copy then propagates that cache metadata, while a hash-equal
         destination skips the copy entirely. Mode is therefore an explicit materialization postcondition:
         the client shim is executable and every other receiver asset is not, on both copied and verified
         paths. File API cannot portably set Unix mode from this netstandard task, so chmod at the target
         edge. Windows has no exec bit and needs none. Each path is quoted — a receiver checkout under a
         spaced path (macOS "Application Support", Windows "C:\Users\John Doe") would otherwise split the
         command and red the consumer's build. -->
    <Exec Condition="'$(OS)' != 'Windows_NT' And '@(_FsggKitNonClient)' != ''"
          Command="chmod a-x @(_FsggKitNonClient->'&quot;%(FullPath)&quot;', ' ')" />
    <Exec Condition="'$(OS)' != 'Windows_NT' And '@(_FsggKitClient)' != ''"
          Command="chmod a+x @(_FsggKitClient->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>

  <!-- §8's assertion, separately invocable and automatically run.
       AUTOMATIC: `AfterTargets="FsggKitMaterialize"` means every materialize — every local one, and
       every `kit-materialize.yml` run on a bump PR — asserts the view roots it just swept, with NO
       receiver wiring at all. That is the property that matters: a check a receiver has to remember
       to wire is a check that reaches the repos which did not need it.
       SEPARATELY INVOCABLE: `dotnet build .config/kit/FS.GG.Kit.receiver.proj -t:FsggKitCheckSkillView`
       is one line in a receiver's own gate.yml and asserts the view on EVERY pull request, without
       materializing anything. §8 wants the assertion in CI; a materialize only happens on bump PRs,
       so a receiver that wants it on all of them adds that line. It needs no arguments and no
       expected-set of its own — the package it references carries both. -->
  <Target Name="FsggKitCheckSkillView" AfterTargets="FsggKitMaterialize">
    <CheckSkillView KitDir="$(FsggKitDir)" ReceiverRoot="$(FsggKitReceiverRoot)"
                    ViewSkillRoots="$(FsggKitViewSkillRoots)" />
  </Target>

  <Target Name="FsggKitMaterializeOnBuild"
          AfterTargets="Build"
          Condition="'$(FsggKitMaterializeOnBuild)' == 'true'"
          DependsOnTargets="FsggKitMaterialize" />

</Project>
