<Project>

  <!--
    FS.GG.Kit materialize + verify (ADR-0062, ADR-0014). Auto-imported by NuGet from the package's
    build/ folder. A package reference is not a file on disk, but the agent harness loads skills as
    real files (ADR-0011) and `scripts/fsgg-coord` must be executable — so a receiver MATERIALIZES the
    packaged kit onto disk. This is the load-bearing half of ADR-0062: getting it wrong would trade a
    loud sync PR for a SILENTLY missing skill, so the materialize is content-addressed and fails LOUD.

    The packed kit sits beside this file at ../kit/, described by ../kit/kit-manifest.tsv
    (kind <TAB> package-rel path <TAB> receiver dest <TAB> sha256). MaterializeKit copies each entry to
    its receiver destination(s), verifies the bytes against the recorded sha256, and ERRORS on a missing
    or mismatched file rather than skipping it. The coordination kit (skill/client/config) always
    materializes; the build-config capability is opt-in (IncludeBuildConfig).
  -->

  <PropertyGroup>
    <FsggKitDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../kit'))</FsggKitDir>
  </PropertyGroup>

  <UsingTask TaskName="MaterializeKit" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$([MSBuild]::NormalizePath('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))">
    <Task>
      <Code Type="Class" Language="cs">
        <![CDATA[
        using System;
        using System.Collections.Generic;
        using System.IO;
        using System.Security.Cryptography;
        using Microsoft.Build.Framework;
        using Microsoft.Build.Utilities;

        public class MaterializeKit : Task
        {
            public string KitDir { get; set; }
            public string ReceiverRoot { get; set; }
            public string SkillRoots { get; set; }
            // The build-config capability (Directory.Build.props / Directory.Packages.props) reaches
            // only 4 of the receivers and .github imports rather than copies it, so it is OPT-IN: a
            // consumer that wants it sets FsggKitMaterializeBuildConfig=true. Off, build-config rows are
            // skipped; the coordination kit always materializes.
            public bool IncludeBuildConfig { get; set; }

            // Hand-authored-file safety (.github#387), mirroring sync-build-config.sh. A canonical
            // build-config .props carries MARKER; a hand-authored repo file does not. First-time adoption
            // (FsggKitAdoptBuildConfig=true) moves a pre-existing UNMARKED .props to *.local.props — which
            // the canonical file <Import>s — so repo-specific settings survive the takeover. Off (the
            // default), the task REFUSES to overwrite an unmarked .props rather than silently clobber it.
            // This gate is build-config only: the coordination kit (skills/client/config) is distributed,
            // content-addressed content nobody hand-authors, so its overwrite stays unconditional.
            public bool AdoptBuildConfig { get; set; }

            // A canonical synced .props carries this exact string (see dist/dotnet/Directory.Build.props);
            // it is the same marker sync-build-config.sh keys its refusal on, so the two tools agree on
            // what "hand-authored" means.
            const string Marker = "Source of truth: FS-GG/.github";

            [Output] public ITaskItem[] ClientFiles { get; set; }

            static string Sha256Hex(string path)
            {
                using (var sha = SHA256.Create())
                using (var fs = File.OpenRead(path))
                    return BitConverter.ToString(sha.ComputeHash(fs)).Replace("-", "").ToLowerInvariant();
            }

            static bool CarriesMarker(string path)
            {
                return File.Exists(path) && File.ReadAllText(path).Contains(Marker);
            }

            public override bool Execute()
            {
                var manifest = Path.Combine(KitDir, "kit-manifest.tsv");
                if (!File.Exists(manifest))
                {
                    Log.LogError("FS.GG.Kit: kit-manifest.tsv not found under " + KitDir + " — the package is malformed.");
                    return false;
                }

                var roots = new List<string>();
                foreach (var r in (SkillRoots ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
                    roots.Add(r.Trim());

                var clients = new List<ITaskItem>();
                int copied = 0, verified = 0;

                foreach (var raw in File.ReadAllLines(manifest))
                {
                    var line = raw.Trim();
                    if (line.Length == 0) continue;
                    var f = line.Split('\t');
                    if (f.Length != 4)
                    {
                        Log.LogError("FS.GG.Kit: malformed manifest row (want 4 tab-separated fields): " + line);
                        continue;
                    }
                    string kind = f[0], pkgRel = f[1], receiverDest = f[2], want = f[3].ToLowerInvariant();

                    // build-config is opt-in (see IncludeBuildConfig): skip it unless the consumer asked.
                    if (kind == "build-config" && !IncludeBuildConfig) continue;

                    var src = Path.Combine(KitDir, pkgRel.Replace('/', Path.DirectorySeparatorChar));
                    if (!File.Exists(src))
                    {
                        Log.LogError("FS.GG.Kit: packaged kit file missing: " + pkgRel + " — cannot materialize " + receiverDest + ".");
                        continue;
                    }
                    var srcHash = Sha256Hex(src);
                    if (!string.Equals(srcHash, want, StringComparison.OrdinalIgnoreCase))
                    {
                        Log.LogError("FS.GG.Kit: package integrity — " + pkgRel + " sha256 " + srcHash + " != manifest " + want + ".");
                        continue;
                    }

                    var dests = new List<string>();
                    if (kind == "skill")
                        foreach (var root in roots)
                            dests.Add(Path.Combine(ReceiverRoot, root, receiverDest.Replace('/', Path.DirectorySeparatorChar)));
                    else
                        dests.Add(Path.Combine(ReceiverRoot, receiverDest.Replace('/', Path.DirectorySeparatorChar)));

                    foreach (var dest in dests)
                    {
                        Directory.CreateDirectory(Path.GetDirectoryName(dest));

                        // Hand-authored-file safety (.github#387) — build-config .props only. An existing
                        // dest that does NOT carry the marker was written by the receiver, not by a prior
                        // sync/materialize, so overwriting it would destroy their settings.
                        if (kind == "build-config" && File.Exists(dest) && !CarriesMarker(dest))
                        {
                            var localDest = dest.EndsWith(".props", StringComparison.OrdinalIgnoreCase)
                                ? dest.Substring(0, dest.Length - ".props".Length) + ".local.props"
                                : dest + ".local";
                            if (!AdoptBuildConfig)
                            {
                                Log.LogError("FS.GG.Kit: refusing to overwrite hand-authored " + dest +
                                    " (no '" + Marker + "' marker). Set FsggKitAdoptBuildConfig=true once to move it to " +
                                    Path.GetFileName(localDest) + " (imported by the canonical file), or remove it first.");
                                continue;
                            }
                            if (File.Exists(localDest))
                            {
                                // Both a hand-authored dest and a pre-existing *.local.props exist. Moving
                                // dest onto localDest would destroy the latter; fall-through would destroy
                                // the former. Refuse — fail-closed, exactly as sync-build-config.sh --adopt.
                                Log.LogError("FS.GG.Kit: refusing to adopt " + dest + ": a hand-authored " +
                                    Path.GetFileName(dest) + " and " + Path.GetFileName(localDest) + " both exist. Merge the " +
                                    "settings you want into " + Path.GetFileName(localDest) + ", delete " + Path.GetFileName(dest) +
                                    ", then re-materialize.");
                                continue;
                            }
                            File.Move(dest, localDest);
                            Log.LogMessage(MessageImportance.High, "FS.GG.Kit: adopted " + Path.GetFileName(dest) +
                                " -> " + Path.GetFileName(localDest) + " (hand-authored settings preserved via import).");
                        }

                        if (!File.Exists(dest) || !string.Equals(Sha256Hex(dest), want, StringComparison.OrdinalIgnoreCase))
                        {
                            File.Copy(src, dest, true);
                            copied++;
                        }
                        var got = Sha256Hex(dest);
                        if (!string.Equals(got, want, StringComparison.OrdinalIgnoreCase))
                        {
                            Log.LogError("FS.GG.Kit: materialized " + dest + " sha256 " + got + " != " + want + ".");
                            continue;
                        }
                        verified++;
                        if (kind == "client") clients.Add(new TaskItem(dest));
                    }
                }

                ClientFiles = clients.ToArray();
                // A floor, not decoration: an EMPTY or truncated-to-zero manifest would otherwise
                // materialize nothing and report success — a silently missing kit, the one failure mode
                // ADR-0062 exists to rule out. The producer guards this too (stage-kit.sh), but the
                // consumer-side task is where the load-bearing guarantee is asserted, so it holds the
                // line independently.
                if (verified == 0 && !Log.HasLoggedErrors)
                    Log.LogError("FS.GG.Kit: kit-manifest.tsv named no files to materialize — the package is malformed or truncated.");

                if (!Log.HasLoggedErrors)
                    Log.LogMessage(MessageImportance.High,
                        "FS.GG.Kit: materialized " + verified + " file(s) (" + copied + " written) into " + ReceiverRoot + ".");
                return !Log.HasLoggedErrors;
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Public entry point. Invoke explicitly (`dotnet build -t:FsggKitMaterialize`) or let it run as part
       of the consumer's build (FsggKitMaterializeOnBuild, default true). -->
  <Target Name="FsggKitMaterialize">
    <MaterializeKit KitDir="$(FsggKitDir)" ReceiverRoot="$(FsggKitReceiverRoot)" SkillRoots="$(FsggKitSkillRoots)"
                    IncludeBuildConfig="$(FsggKitMaterializeBuildConfig)" AdoptBuildConfig="$(FsggKitAdoptBuildConfig)">
      <Output TaskParameter="ClientFiles" ItemName="_FsggKitClient" />
    </MaterializeKit>
    <!-- The client shim must be executable; File API cannot set the +x bit on netstandard, so chmod on
         unix. Windows has no exec bit and needs none. Each path is quoted — a receiver checkout under a
         spaced path (macOS "Application Support", Windows "C:\Users\John Doe") would otherwise split the
         command and red the consumer's build. -->
    <Exec Condition="'$(OS)' != 'Windows_NT' And '@(_FsggKitClient)' != ''"
          Command="chmod +x @(_FsggKitClient->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>

  <Target Name="FsggKitMaterializeOnBuild"
          AfterTargets="Build"
          Condition="'$(FsggKitMaterializeOnBuild)' == 'true'"
          DependsOnTargets="FsggKitMaterialize" />

</Project>
