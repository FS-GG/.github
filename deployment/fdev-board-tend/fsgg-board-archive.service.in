# Rendered by install.py archive; installation does not enable or start this unit (#5170).
[Unit]
Description=FS-GG Project3 guarded Done retention

[Service]
Type=exec
WorkingDirectory=@WORKDIR@
Environment=XDG_RUNTIME_DIR=%t
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_STATE_HOME=%h/.local/state
RuntimeDirectory=fsgg
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
# No PrivateTmp: the archiver shares the literal /tmp legacy writer locks with the installed engine.
CPUQuota=100%
MemoryMax=1G
MemorySwapMax=0
RuntimeMaxSec=900
TimeoutStopSec=30
KillMode=control-group
# No Restart: an incomplete run retains the adapter's durable latch for Root readback.
ExecStart=/usr/bin/python3 -I @RELEASE_DIR@/fsgg-board-archive-run.py --config @CONFIG@ --credentials @CREDENTIALS@
