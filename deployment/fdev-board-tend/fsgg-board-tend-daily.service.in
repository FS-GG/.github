# Rendered by deployment/fdev-board-tend/install.py from fsgg-board-tend-daily.service.in (Refs FS-GG/.github#5136).
# Local and read-only: summarises yesterday's plan-only runs into the private daily record. It posts nothing.
[Unit]
Description=FS-GG board-v2 tend daily observation record (Refs FS-GG/.github#5136)

[Service]
Type=oneshot
WorkingDirectory=@WORKDIR@
Environment=XDG_CONFIG_HOME=@CONFIG_HOME@
Environment=XDG_STATE_HOME=@STATE_HOME@
UMask=0077
NoNewPrivileges=yes
TimeoutStartSec=120
ExecStart=/usr/bin/python3 -I @LIBEXEC@/fsgg-board-tend-run.py summarize --date yesterday --config-home @CONFIG_HOME@ --state-home @STATE_HOME@
