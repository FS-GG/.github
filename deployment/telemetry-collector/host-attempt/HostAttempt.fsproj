<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AttemptTypes.fs" />
    <Compile Include="AttemptPreparation.fs" />
    <Compile Include="AttemptAcquisition.fs" />
    <Compile Include="AttemptReducer.fs" />
    <Compile Include="AttemptOperation.fs" />
    <Compile Include="AttemptMechanism.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HostAttempt.Tests" />
    <InternalsVisibleTo Include="HostAttempt.Correspondence" />
  </ItemGroup>
</Project>
