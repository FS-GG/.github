# syntax=docker/dockerfile:1

# Policy owned Linux x64 runtime. Callers cannot replace this base.
FROM mcr.microsoft.com/dotnet/aspnet:10.0.12-noble-amd64@sha256:0fa044f682cb7d93a5a90401a00c626c66f7b00b86922be9441f869eae039f80 AS runtime

FROM runtime AS controlled-development
COPY --chown=0:0 controlled-development.sh /opt/fsgg/controlled-development
RUN chmod 0555 /opt/fsgg/controlled-development
USER 32768:32768
ENTRYPOINT ["/opt/fsgg/controlled-development"]

FROM runtime AS collector
ARG HOST_VERSION
ARG HOST_SOURCE_SHA
ARG HOST_PACKAGE_SHA256
ARG HOST_MANIFEST_SHA256
ARG HOST_JOURNAL_SHA256
LABEL org.opencontainers.image.title="FS.GG dedicated telemetry collector" \
      org.opencontainers.image.version="${HOST_VERSION}" \
      org.opencontainers.image.revision="${HOST_SOURCE_SHA}" \
      org.fsgg.telemetry.host.package-sha256="${HOST_PACKAGE_SHA256}" \
      org.fsgg.telemetry.host.manifest-sha256="${HOST_MANIFEST_SHA256}" \
      org.fsgg.telemetry.host.journal-sha256="${HOST_JOURNAL_SHA256}" \
      org.fsgg.telemetry.collector.activation="disabled-before-readiness"
COPY --chown=0:0 host/ /opt/fsgg/telemetry-host/
COPY --chown=0:0 controlled-collector.sh /opt/fsgg/controlled-collector
RUN chmod -R a-w /opt/fsgg/telemetry-host \
    && chmod 0555 /opt/fsgg/controlled-collector \
    && test -f /opt/fsgg/telemetry-host/FS.GG.Telemetry.Host.dll \
    && test -f /opt/fsgg/telemetry-host/FS.GG.Telemetry.Host.runtimeconfig.json
USER 32768:32768
ENTRYPOINT ["/usr/bin/dotnet", "/opt/fsgg/telemetry-host/FS.GG.Telemetry.Host.dll"]
