# LEARN finite executor pod image learn-pod-app:r1 (design docs/coordination/2026-10-30-learn-finite-executor-pod-design.md section 2.2 and 2.3;
# Refs FS-GG/.github#4647). NOT built, NOT admitted. Build as fsgg-learn-qual only, through learn-build-pod-app-r1.py, from a root-owned hash-pinned context:
#   podman build --network=none --pull=never --no-cache --timestamp 0 --build-context telemetry=<staged tree> --build-context cli=<staged tree> -f Containerfile -t localhost/learn-pod-app:r1 <context>
# Built FROM the admitted learn-qualification:v1 Id, NOT from reader image r4: r4's entrypoint is a one-shot wrapper with one /out/.status and a
# 10-slot dotnet shim, which three long-running containers would collide on. Nothing of r4 is inherited here: no shim, no slot helper, no /usr/local/libexec/learn.
# The builder passes every pin below as a --build-arg taken from ITS OWN constants, and the RUN step re-hashes what was actually copied into the image,
# so a context file swapped between the builder's check and the build is caught inside the build.
FROM 20a6df20169ce6721ed91fddd0d24ae7fe8de655008b422df0c3299821b7d4b8
ARG SHA_ROLE
ARG SHA_PROBE
ARG SHA_HOST
ARG SHA_RUNNER
ARG SHA_MANIFEST
ARG SHA_TELEMETRY_TREE
ARG SHA_CLI_TREE
ARG MIN_NETCORE
ARG MIN_ASPNET
USER 0:0
COPY --chmod=0555 role /opt/fsgg/pod/role
COPY --chmod=0555 learn-probe /opt/fsgg/pod/probe
COPY --chmod=0555 host/fsgg-coord-orchestration-host /opt/fsgg/orchestration/host/fsgg-coord-orchestration-host
COPY --chmod=0555 runner/fsgg-coord-orchestration-runner /opt/fsgg/orchestration/runner/fsgg-coord-orchestration-runner
COPY --chmod=0444 manifest.json /opt/fsgg/orchestration/manifest.json
COPY --from=telemetry . /opt/fsgg/telemetry-host/
COPY --from=cli . /opt/fsgg/producer/
RUN set -eu; \
    test -x /usr/bin/catatonit; \
    find /opt/fsgg/telemetry-host /opt/fsgg/producer -type d -exec chmod 0555 '{}' +; \
    find /opt/fsgg/telemetry-host /opt/fsgg/producer -type f -exec chmod 0444 '{}' +; \
    printf '%s  %s\n' \
      "$SHA_ROLE" /opt/fsgg/pod/role \
      "$SHA_PROBE" /opt/fsgg/pod/probe \
      "$SHA_HOST" /opt/fsgg/orchestration/host/fsgg-coord-orchestration-host \
      "$SHA_RUNNER" /opt/fsgg/orchestration/runner/fsgg-coord-orchestration-runner \
      "$SHA_MANIFEST" /opt/fsgg/orchestration/manifest.json | sha256sum -c -; \
    treelist() { (cd "$1" && find . -type f | LC_ALL=C sort | while read -r f; do printf '%s  %s\n' "$(sha256sum "$f" | cut -d' ' -f1)" "${f#./}"; done | sha256sum | cut -d' ' -f1); }; \
    test "$(treelist /opt/fsgg/telemetry-host)" = "$SHA_TELEMETRY_TREE"; \
    test "$(treelist /opt/fsgg/producer)" = "$SHA_CLI_TREE"; \
    test -f /opt/fsgg/producer/fsgg-coord-engine.dll; \
    for fw in "Microsoft.NETCore.App $MIN_NETCORE" "Microsoft.AspNetCore.App $MIN_ASPNET"; do \
      set -- $fw; \
      best=$(ls /usr/share/dotnet/shared/"$1" | LC_ALL=C sort -V | tail -n 1); \
      test -n "$best"; \
      test "$(printf '%s\n%s\n' "$2" "$best" | LC_ALL=C sort -V | head -n 1)" = "$2"; \
      echo "RUNTIME $1 $best (minimum $2)"; \
    done; \
    grep -q '^[^:]*:[^:]*:1000:' /etc/passwd || { ! grep -q '^pod:' /etc/passwd && echo 'pod:x:1000:1000:LEARN pod user:/work/home:/sbin/nologin' >> /etc/passwd; }; \
    grep -q '^[^:]*:[^:]*:1000:' /etc/group || { ! grep -q '^pod:' /etc/group && echo 'pod:x:1000:' >> /etc/group; }; \
    grep -q '^[^:]*:[^:]*:1000:' /etc/passwd; grep -q '^[^:]*:[^:]*:1000:' /etc/group
ENV HOME=/work/home TMPDIR=/work/tmp DOTNET_CLI_HOME=/work/home DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_gcServer=0
USER 1000:1000
ENTRYPOINT ["/usr/bin/catatonit", "--", "/opt/fsgg/pod/role"]
CMD []
