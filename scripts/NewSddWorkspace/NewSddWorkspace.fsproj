<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Roll forward if the exact net10.0 runtime is absent on the host, matching the org's
         CLI convention (FS.GG.SDD.Cli). -->
    <RollForward>Major</RollForward>

    <!-- Distribute as a .NET global tool so the clone-free install the tutorial documents
         keeps working: `dotnet tool install -g FS.GG.NewSddWorkspace` exposes the
         `new-sdd-workspace` command (the F# successor to the retired shell script; ADR-0016).
         Renamed from FS.GG.NewSddFullstack — "fullstack" wrongly implied one app shape once the
         profile flag made the output-app shape selectable; "workspace" is the ADR-0020 term for
         what a consumer scaffolds. Package identity = product identity, do not rename in place;
         the old preview id (up to 0.1.1-preview.1) is superseded/delisted, not moved. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>new-sdd-workspace</ToolCommandName>
    <PackageId>FS.GG.NewSddWorkspace</PackageId>
    <!-- Independent Creator successor: the canonical work-board materializer is packaged here.
         Coherent 0.108 does not publish this tool; its own candidate and publisher qualify each independent successor. -->
    <Version>0.23.1</Version>
    <PackageReleaseNotes>0.23.1 repairs default-coordination creations of 0.23.0 (#4964). The Wizard no longer writes its own members into the SDD-owned .fsgg/scaffold-provenance.json, whose strict schema in SDD CLI 2.5.3 rejected the unknown securityObligations member and made fsgg-sdd doctor incoherent. Pending and verified security state, with the same rows, human-verification text and resume commands, is stored in the Wizard-owned .fsgg/security-obligations.json, and the retrofit log in .fsgg/coordination-retrofits.json. The next secure or retrofit run, or an --upgrade run on an existing workspace, tolerantly migrates the members that 0.23.0 wrote into provenance. The coordination kit is no longer read from the moving main of FS-GG/.github: it is pinned to FS-GG/.github commit a9a6f77f32bda1138af35981bd5fffee5f0f6594 by sha256 anchors and verified before any write; a digest mismatch refuses the kit and writes nothing, while a file that cannot be fetched still warns. Catalog creation with stable SDD CLI 2.5.3 or newer, the published FS.GG.Templates 0.20.1 selection and registry defaults are unchanged. The independent release route reuses authenticated published coherent113 dependencies. Published Creator 0.23.0 and its journal remain immutable history. Publication and genuine installed adoption require their own acceptance.</PackageReleaseNotes>
    <AssemblyName>new-sdd-workspace</AssemblyName>

    <Description>FS.GG workspace scaffolder — composes a selectable Standard or Typed SDD lifecycle, a runnable provider workspace, and an optional Governance overlay in one command, with a rich Spectre.Console progress UI. Orchestrates existing published machinery; no FS.GG.Templates checkout required.</Description>
    <Authors>FS-GG</Authors>
    <Company>FS-GG</Company>
    <PackageTags>fsgg;scaffold;workspace;dotnet-tool;sdd;spectre</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/FS-GG/.github</RepositoryUrl>
    <PackageProjectUrl>https://github.com/FS-GG/.github/tree/main/scripts/NewSddWorkspace</PackageProjectUrl>

    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProviderCatalog.fsi" />
    <Compile Include="ProviderCatalog.fs" />
    <Compile Include="ProductBoard.fsi" />
    <Compile Include="ProductBoard.fs" />
    <Compile Include="SecurityObligations.fsi" />
    <Compile Include="SecurityObligations.fs" />
    <Compile Include="RetrofitLog.fsi" />
    <Compile Include="RetrofitLog.fs" />
    <Compile Include="CoordinationKit.fsi" />
    <Compile Include="CoordinationKit.fs" />
    <Compile Include="Program.fs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="coordination-kit-pin.json"
                      LogicalName="NewSddWorkspace.CoordinationKitPin.json" />
    <EmbeddedResource Include="../../.claude/skills/initialize-sdd-workspace/SKILL.md"
                      LogicalName="NewSddWorkspace.InitializeSkill.SKILL.md" />
    <EmbeddedResource Include="../../.claude/skills/initialize-sdd-workspace/agents/openai.yaml"
                      LogicalName="NewSddWorkspace.InitializeSkill.agents.openai.yaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FS.GG.Coord.Cli/FS.GG.Coord.Cli.fsproj"
                      Condition="'$(FsggFrozenCoordDependencies)' == '' And '$(FsggFrozenCoordSource)' == ''" />
    <ProjectReference Include="$(FsggFrozenCoordSource)/src/FS.GG.Coord.Cli/FS.GG.Coord.Cli.fsproj"
                      Condition="'$(FsggFrozenCoordDependencies)' != '' And '$(FsggFrozenCoordSource)' != ''" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <!-- The candidate may consume the exact published implementation outputs. Keep the
       eleven-project graph: MSBuild GetTargetPath resolves the verified staged bodies,
       while the release route compiles only this independently versioned creator. -->
  <PropertyGroup Condition="'$(FsggFrozenCoordDependencies)' != ''">
    <BuildProjectReferences>false</BuildProjectReferences>
    <CompileUsingReferenceAssemblies>false</CompileUsingReferenceAssemblies>
    <!-- GetTargetPath still resolves the staged implementation assemblies. Child
         content queries would also advertise an unbuilt obj/apphost; the exact
         published closure below supplies all dependency content instead. -->
    <_GetChildProjectCopyToOutputDirectoryItems>false</_GetChildProjectCopyToOutputDirectoryItems>
    <_GetChildProjectCopyToPublishDirectoryItems>false</_GetChildProjectCopyToPublishDirectoryItems>
  </PropertyGroup>
  <ItemGroup Condition="'$(FsggFrozenCoordDependencies)' != ''">
    <!-- The normal reference route copies these three verified staged files and
         retains the coherent CLI runtime dependency metadata. Copy the other
         published files here, avoiding duplicate destinations. -->
    <None Include="$(FsggFrozenCoordDependencies)/**/*"
          Exclude="$(FsggFrozenCoordDependencies)/fsgg-coord-engine.dll;$(FsggFrozenCoordDependencies)/fsgg-coord-engine.pdb;$(FsggFrozenCoordDependencies)/fsgg-coord-engine.xml"
          Link="%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <Target Name="ValidateFrozenCoordSelection" BeforeTargets="PrepareForBuild">
    <Error Condition="('$(FsggFrozenCoordDependencies)' == '' And '$(FsggFrozenCoordSource)' != '') Or ('$(FsggFrozenCoordDependencies)' != '' And '$(FsggFrozenCoordSource)' == '')"
           Text="Frozen coordination source and published binary roots must be supplied together." />
  </Target>
  <Target Name="VerifyFrozenCoordDependencies" BeforeTargets="PrepareForBuild"
          Condition="'$(FsggFrozenCoordDependencies)' != ''">
    <Exec Condition="'$(FsggCurrentCoordDependencies)' != 'true'" Command="python3 &quot;$(MSBuildThisFileDirectory)../creator-frozen-coord-dependencies.py&quot; verify-layout --producer-source &quot;$(FsggFrozenCoordSource)&quot; --dependencies &quot;$(FsggFrozenCoordDependencies)&quot;" />
    <Exec Condition="'$(FsggCurrentCoordDependencies)' == 'true'" Command="python3 &quot;$(MSBuildThisFileDirectory)../creator-current-coord-dependencies.py&quot; verify-layout --producer-source &quot;$(FsggFrozenCoordSource)&quot; --dependencies &quot;$(FsggFrozenCoordDependencies)&quot;" />
  </Target>
</Project>
