#!/usr/bin/env bash
# coordination-sync — distribute/verify the coordination kit into a receiver repo (ADR-0019 slice 2).
#
# The coordination kit (the `kind: skill` skills + the fsgg-coord client) is declared,
# content-addressed, in registry/repos.yml. This script is the DISTRIBUTION + COHERENCE arm over that
# declaration — the participant-side analog of scripts/sync-build-config.sh, whose shape it mirrors:
#
#   coordination-sync <target>            # write/update the kit into <target> (a receiver checkout)
#   coordination-sync --check <target>    # drift check only; exit 1 on drift (the CI coherence gate)
#   coordination-sync --repo <full> ...   # gate on the roster: if <full> does not `receives:
#                                         # coordination-kit`, there is nothing to do — exit 0
#   coordination-sync --check --base-ref <ref> <target>
#                                         # ATTRIBUTE the drift instead of merely reporting it (#450).
#                                         # Only drift THIS BRANCH AUTHORED (vs <ref>, merge-base) is an
#                                         # error; drift it merely INHERITED from an out-of-date base is
#                                         # an advisory naming whose job it is. Without --base-ref the
#                                         # check is the strict tree compare it has always been.
#   coordination-sync --check --against-pin <target>
#                                         # verify against the RECEIVER'S OWN PIN, not this checkout
#                                         # (#1584). The comparand is the FS.GG.Kit package version the
#                                         # receiver itself references, restored from the feed, compared
#                                         # against the sha256s that package's own kit-manifest.tsv
#                                         # ships. This is what the CI gate runs. See PIN-RELATIVE below.
#
# `.github` (this repo, the ADR-0019 authority) is the canonical SOURCE — the kit files under this
# checkout are the source of truth, exactly as sync-build-config's dist/dotnet/ is. Two arms carry the
# kit to the receivers, and it is worth being precise about which does what — a vague claim here that
# propagation "rides the existing dispatch fabric" is exactly why two workers each assumed the other's
# tooling had it covered, and hand-synced the same kit twice in one day (#463):
#
#   PULL (the gate)   .github/workflows/coordination-coherence.yml checks out both this repo and the
#                     caller and runs `--check`, so a receiver's CI FAILS when its kit has drifted.
#                     It reports drift. It cannot fix it.
#   DELIVERY          each receiver takes the kit as the versioned FS.GG.Kit package (ADR-0062): it
#                     references the package at a pinned version and MATERIALIZES the kit onto disk
#                     (.config/kit/FS.GG.Kit.receiver.proj). A hub change is one publish; Renovate bumps
#                     the pin and kit-materialize.yml re-materializes the committed kit on that PR. The
#                     byte-copy PUSH arm (coordination-propagate.yml, which ran this script in APPLY
#                     mode to open a rolling sync PR per receiver) was retired in #1262 step 3. This
#                     script's APPLY mode lives on — kit-materialize's verify + the materialize use it.
#
# Managed kit files (source here -> path in the receiver):
#   scripts/fsgg-coord                                          -> scripts/fsgg-coord              (chmod +x)
#   <kit row's `source`>/<relative file>                        -> <root>/<basename source>/<relative file>
#     ...for each `kind: skill` row in repos.yml and each root in AGENT_SKILL_ROOTS (default roots:
#        ".claude/skills .agents/skills"). The skill list is READ from the registry,
#        never copied.
# Each skill DIRECTORY is the transport unit: every regular file and its executable bit is managed.
#
#
# PIN-RELATIVE VERIFICATION (--against-pin, #1584) — WHY THE COMPARAND MOVED
#
# The strict arm above compares a receiver's tree against THIS CHECKOUT at check time. `.github@main`
# moves constantly, so a receiver's verdict is a function of WHEN the check ran rather than of what the
# receiver committed. On 2026-07-27 the required `kit / coordination-kit` context passed on FS.GG.SDD's
# merged SHA 0376309 at 08:15Z and FAILED on byte-identical content at 08:21Z, because the hub had
# moved in between (FS.GG.SDD#731). Six receivers were "repaired" in one day for a drift none of them
# caused. A green required check that can go red with nothing changed is not a durable statement, so
# branch protection cannot mean what it says.
#
# --against-pin makes the verdict a function of the RECEIVER ALONE:
#   1. DERIVE the receiver's own FS.GG.Kit version by resolving its receiver project the way MSBuild
#      resolves it (inline Version / VersionOverride, else the CPM walk up to Directory.Packages.props
#      and the imports that file itself declares). The three pin shapes the org uses today are not a
#      LIST here — they are what falls out of following MSBuild's own resolution, which is the whole
#      difference between this and the hand-maintained location tables #1507/#1510/#1515/#1528 closed.
#   2. RESTORE that exact version from the flat-container feed (anonymous; FS.GG.Kit is public).
#   3. VERIFY every materialized destination against the sha256s that package's kit-manifest.tsv ships.
#
# A hub commit can now NEVER retroactively red a receiver: nothing in steps 1-3 reads a byte of this
# checkout. A receiver goes red only when its own tree diverges from its own pin — an invariant wholly
# inside its control, and therefore durable.
#
# WHAT THIS DELIBERATELY STOPS DETECTING. A receiver pinned two versions back with a perfectly
# materialized tree is now legitimately, permanently green. That is the trade, and it is not
# hypothetical: FS.GG.Audio sat green all day at kit 0.6.0 while every other receiver moved to 0.8.x.
# "Is my pin current?" is a DIFFERENT question and it has a different owner — the kit-pin freshness
# sweep in scripts/repos-audit.sh (#1540), which is f(roster, feed), needs no receiver to push, runs
# daily at 08:17 UTC, and exits 1 (a red workflow with a named ::error::) on any stale pin. It is
# advisory in the sense AC7 means — it gates no receiver's PR — and emphatically NOT advisory at org
# level, which is what makes it safe to be the sole "you are behind" signal. Do not re-add a staleness
# opinion here; two gates answering one question is how both get ignored.
#
# WHAT THIS IS NOT PROOF OF (state this plainly, #1584 risk 3). The manifest verified against ships
# INSIDE the package being verified, so this check is self-attesting: a package built with a manifest
# that disagrees with its own payload is invisible to a tree-vs-manifest compare. It catches the
# package's INTERNAL disagreement (payload vs its own manifest, below) but it cannot see a package
# whose payload disagrees with CANONICAL. That question belongs to check-kit-published-coherence.py,
# on the hub side. The end-to-end invariant "a receiver's files are canonical's files" holds only in
# COMPOSITION with that gate, and only for as long as that gate is HEALTHY — which is a live condition,
# not a constant. It went red on 2026-07-27 when FS.GG.Kit 0.8.0 fell behind canonical (#1583, repaired
# the same day by the 0.9.0 bump in #1605), and every hour it is red is an hour a green here is worth
# less than it looks. Check that gate before treating a green here as end-to-end proof; it is not one.
#
# Env: AGENT_SKILL_ROOTS  skill roots to materialize the skill into (default
#                         ".claude/skills .agents/skills").
#      FSGG_NUGET_ORG_BASE      override the flat-container base (--against-pin; the fixture points this
#                               at a local file:// tree, so the test drives the real fetch/parse path).
#      FSGG_KIT_FETCH_TRIES     attempts for a RETRYABLE feed failure (default 3).
#      FSGG_KIT_FETCH_BACKOFF_S seconds between those attempts (default 3).
# Exit: 0 = in sync / written, or drift this branch did not author (--base-ref); 1 = drift; 2 = misconfiguration; 3 = INCONCLUSIVE (--against-pin: nothing was verified).
#       Every code stays on the `Exit:` line above, on ONE line, because that line is what --help is
#       asserted to carry and what a caller reads the contract off. A `sed` range once truncated this
#       block and hid the exit codes — the one thing a caller must know (#335) — so the fixture greps
#       that line for each code. Wrapping 3 onto a continuation would pass a rc-only assertion while
#       silently undocumenting it, which is the same rot one field over.
#       3 is not 0 and it is not 1 on purpose: "I could not check" must never render as "I checked, and
#       it's fine" (#266), and it must not render as "your tree is wrong" either (#320). Callers retry
#       a 3 whose message says RETRYABLE; a re-run reproduces every other 3 exactly.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_ROOT="$(cd "$HERE/.." && pwd)"                 # the .github checkout = canonical kit source
REG="$SRC_ROOT/registry/repos.yml"
DEFAULT_ROOTS=".claude/skills .agents/skills"   # ADR-0065 (as amended by ADR-0067 §5): one per lane.
# `resolve_roots` (lib/roots.sh) also sets ROOTS_SRC and ROOTS_FROM_DEFAULT. This lane reads neither —
# it materializes the kit rather than reporting on which rule chose the roots — so they are not
# pre-declared here. skill-union-assert.sh, which does read both, declares both. (#648)
ROOTS=""

die()   { echo "coordination-sync: $*" >&2; exit 2; }
# need_val (a flag with no value is a misconfiguration, not the exit-1 "kit has drifted" verdict) is
# shared with repos-audit.sh and skill-union-assert.sh; see lib/args.sh. Sourced after die, which it uses.
# shellcheck source=lib/args.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/args.sh"
# resolve_roots — the same root-set precedence skill-union-assert.sh uses to ASSERT the roots, so the
# script that WRITES them cannot disagree with the gate that checks them (#525). Sourced after die.
# shellcheck source=lib/roots.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/roots.sh"
# Print the header block itself — every comment line after the shebang, up to the first line that is
# not one. A hardcoded `sed -n '2,20p'` used to do this, and it had already rotted: the range stopped
# eight lines short, so `--help` documented everything EXCEPT the `Env:` and `Exit:` lines — the exit
# codes being the one thing a caller must know, and the very contract this script was just fixed to
# honour. Same rot, same fix, as repos-audit.sh (#335).
usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; }

mode="apply"; repo=""; target=""; base_ref=""; against_pin=""; receiver_project=""; include_build_config=""
# The receiver project default is the SAME literal kit-materialize.yml declares as its own
# `receiver-project` input default. It is a shared contract with the workflow that WRITES the kit, not a
# location this script invented — the two must name one file or the verifier grades a pin the
# materialize never restored.
DEFAULT_RECEIVER_PROJECT=".config/kit/FS.GG.Kit.receiver.proj"
while [ $# -gt 0 ]; do
  case "$1" in
    --check)                mode="check"; shift ;;
    --repo)                 need_val "$@"; repo="$2"; shift 2 ;;
    --base-ref)             need_val "$@"; base_ref="$2"; shift 2 ;;
    --against-pin)          against_pin="yes"; shift ;;
    --receiver-project)     need_val "$@"; receiver_project="$2"; shift 2 ;;
    --include-build-config) include_build_config="yes"; shift ;;
    -h|--help)              usage; exit 0 ;;
    -*)                     die "unknown flag '$1'." ;;
    *)                      [ -z "$target" ] && target="$1" || die "unexpected argument '$1'."; shift ;;
  esac
done
[ -n "$target" ] || { usage; exit 2; }
[ -d "$target" ] || die "target not found: $target"
target="$(cd "$target" && pwd)"

# Resolve the roots to materialize into — AFTER `target` is known, because the declaration that names
# them belongs to the RECEIVER, not to this checkout. Resolving at load time (as a `${AGENT_SKILL_ROOTS
# :-<default>}` expansion, which is what this was) made the receiver's own `.agent-skill-roots`
# structurally unreachable: the file could not be consulted because the tree holding it had not been
# identified yet. So the writer hardcoded a root set while the gate read a declared one, and the two
# agreed only by coincidence of defaults (#525). Same precedence, same parser, same file — lib/roots.sh.
resolve_roots "$target" "$DEFAULT_ROOTS" "default (ADR-0065's universal three)"
# Attribution is a property of the CHECK. In apply mode there is no branch to attribute drift to, and a
# caller passing --base-ref to a writer has misunderstood the flag — say so rather than ignoring it.
[ -z "$base_ref" ] || [ "$mode" = "check" ] || die "--base-ref is only meaningful with --check."
[ -z "$against_pin" ] || [ "$mode" = "check" ] || die "--against-pin is only meaningful with --check."
[ -n "$against_pin" ] || [ -z "$receiver_project" ] \
  || die "--receiver-project is only meaningful with --against-pin."
[ -n "$against_pin" ] || [ -z "$include_build_config" ] \
  || die "--include-build-config is only meaningful with --against-pin."

# #1584 criterion 6, ANSWERED RATHER THAN INHERITED: the PR-arm/main-arm asymmetry does not carry over.
#
# --base-ref exists because canonical (`.github@main`) moves independently of the branch, so a PR that
# never touched the kit could be red for (2) "your base is behind canonical" or (3) "your branch
# predates a sync already on base". Both are artefacts of a comparand that moves on its own.
#
# A PIN-RELATIVE comparand does not move on its own. It is read out of the branch's OWN tree, so it
# moves WITH the branch — and (2) and (3) become impossible rather than merely rarer:
#   * a branch forked before a Renovate pin bump carries the OLD pin AND the old pin's files, which is
#     coherent, so it is green — where the strict hub compare red it for being behind;
#   * a branch that edits a vendored kit file no longer matches its own pin's manifest, so it is red,
#     and merge-base arithmetic is not needed to know whose it is: nothing else could have moved.
# The one PR that legitimately reds is Renovate's pin bump before kit-materialize re-materializes on it
# — which is correct, is the bot's, and is fixable IN the branch, unlike every red the asymmetry existed
# to suppress.
#
# So the asymmetry is DROPPED here rather than silently kept, and the two flags are refused together
# rather than left to combine into a mode nobody designed. The strict hub-relative arm keeps --base-ref
# unchanged; it is no longer what the CI gate runs.
[ -z "$against_pin" ] || [ -z "$base_ref" ] \
  || die "--base-ref and --against-pin are mutually exclusive. --base-ref attributes drift against a comparand that moves independently of the branch (.github@main); a pin-relative comparand is read from the branch's own tree and moves with it, so there is no inherited drift to attribute (#1584 criterion 6). Drop --base-ref."

# The pin-relative verdict program (#1584). Argv: <receiver root> <receiver project, root-relative>
# <skill roots, space-separated> <yes|no include build-config>. Stdout: a tab-separated ledger the shell
# classifies — `pin`, `source`, `ok`, `drift`, `inconclusive`. It exits 0 whenever it REACHED a verdict,
# including an inconclusive one; a non-zero exit means it crashed, which the caller turns into exit 3.
PIN_VERIFY_PY=$(cat <<'PY'
import hashlib
import io
import os
import stat
import sys
import time
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
import zipfile

sys.path.insert(0, os.environ["FSGG_SCRIPTS_DIR"])
import fsgg_feed  # noqa: E402

PACKAGE = "FS.GG.Kit"

# The flat-container base the pinned package is restored from. Unset in CI, so this reads the real
# nuget.org through fsgg_feed's own constant — the SAME registry the org preset routes FS.GG.* to, and
# therefore the same one the receiver's own `dotnet restore` resolves. The fixture points this at a
# local flat-container tree over file://, which exercises this exact fetch/unzip/verify path rather
# than a mock of it: only the base URL differs between the test and production.
_base = os.environ.get("FSGG_NUGET_ORG_BASE", "").strip()
if _base:
    fsgg_feed.NUGET_ORG = _base.rstrip("/")


def _int_env(name, default):
    try:
        return max(1, int(os.environ.get(name, "").strip() or default))
    except ValueError:
        return default


TRIES = _int_env("FSGG_KIT_FETCH_TRIES", 3)
BACKOFF = _int_env("FSGG_KIT_FETCH_BACKOFF_S", 3)

out = []


def emit(kind, *fields):
    out.append("\t".join([kind, *[str(f).replace("\t", " ").replace("\n", " ") for f in fields]]))


class Inconclusive(Exception):
    """I could not check. Never 'coherent' (#266) and never 'drifted' (#320).

    `retryable` splits the two causes a caller must treat differently: a feed blip resolves itself on a
    re-run, an unresolvable pin reproduces exactly and needs a commit. Collapsing them would make every
    receiver's required check red-forever on a 30-second outage, which is the availability cost #1584's
    risk analysis flagged as the price of putting a package feed in the required-check path.
    """

    def __init__(self, message, retryable=False):
        super().__init__(message)
        self.retryable = retryable


def localname(tag):
    # MSBuild files may or may not carry the 2003 namespace; both spellings are live in this org.
    return tag.rsplit("}", 1)[-1]


def _kit_rows(root, tags):
    for el in root.iter():
        if localname(el.tag) not in tags:
            continue
        # NuGet package ids are case-insensitive; comparing them case-sensitively is how a resolver
        # misses a real pin and reports the repo as unpinned.
        include = (el.get("Include") or el.get("Update") or "").strip()
        if include.lower() != PACKAGE.lower():
            continue
        yield el


def _version_of(el):
    """(version, is_override) for one PackageReference/PackageVersion. (None, False) if versionless."""
    # VersionOverride BEATS the central PackageVersion under CPM, so a repo can carry
    # `<PackageReference Include="FS.GG.Kit" VersionOverride="0.6.0" />` while its
    # Directory.Packages.props says 0.9.0 — and reading only `Version` would verify against the version
    # that is NOT restored, greening a tree that does not match what it actually materializes.
    override = (el.get("VersionOverride") or "").strip()
    if override:
        return override, True
    version = el.get("Version")
    if version is None:
        child = next((c for c in el if localname(c.tag) == "Version"), None)
        version = child.text if child is not None else None
    if version is None:
        return None, False        # a version-less PackageReference IS the CPM shape: pin is elsewhere.
    version = version.strip()
    return (version or None), False


def _property_value(root, name):
    """The first non-empty MSBuild <PropertyGroup> value named `name`."""
    for el in root.iter():
        if localname(el.tag) == name and (el.text or "").strip():
            return (el.text or "").strip()
    return None


def skill_roots(target, proj_rel, archive, override):
    """Where a skill row materializes — WITHOUT asking this hub.

    This is the last place a hub byte could have reached the verdict, and it is worth spelling out why
    it is closed. `coordination-sync`'s own DEFAULT_ROOTS is a constant in THIS checkout: had the pin
    check fallen back to it, editing that constant on the hub would have made every receiver's files
    "missing" in a root they never adopted — no receiver committing anything, every receiver red. That
    is precisely the #1584 defect, surviving through the PROGRAM rather than through the data.

    The materialize's own truth is `FsggKitSkillRoots`, and both places it can come from are pinned or
    receiver-owned, so both are safe:

      1. $AGENT_SKILL_ROOTS      an explicit operator override (a CI knob), and the only one that is
                                 neither — a human asked for it by name, in this run.
      2. the receiver project's <FsggKitSkillRoots>   receiver-owned, in the branch's own tree, exactly
                                 what MSBuild would use.
      3. the PINNED PACKAGE's build/FS.GG.Kit.props default   pinned, so it moves only when the receiver
                                 moves its pin.

    `.agent-skill-roots` is deliberately NOT consulted here. It is the byte-copy fabric's declaration and
    the materialize does not read it, so honouring it would make this gate look somewhere the kit was
    never written — the writer/checker disagreement of #525, one fabric over. No receiver declares one
    today (measured: 0 of 7), so nothing changes hands; the reason is recorded for whoever adds the first.
    """
    if override.strip():
        return [r for r in override.replace(";", " ").split() if r], "$AGENT_SKILL_ROOTS"
    declared = _property_value(_parse(os.path.join(target, proj_rel), proj_rel), "FsggKitSkillRoots")
    if declared:
        return ([r for r in declared.replace(";", " ").split() if r],
                f"{proj_rel} <FsggKitSkillRoots>")
    try:
        props = archive.read("build/FS.GG.Kit.props").decode("utf-8")
    except (KeyError, UnicodeDecodeError) as e:
        raise Inconclusive(
            f"the pinned {PACKAGE} package carries no readable build/FS.GG.Kit.props "
            f"({type(e).__name__}: {e}), so the skill roots it materializes into cannot be read from "
            f"it — and this gate will not substitute the hub's default for them (#1584). The package "
            f"is malformed; nothing was verified."
        )
    try:
        default = _property_value(ET.fromstring(props), "FsggKitSkillRoots")
    except ET.ParseError as e:
        raise Inconclusive(
            f"build/FS.GG.Kit.props in the pinned {PACKAGE} package is not parsable XML ({e}), so the "
            f"skill roots could not be read. Nothing was verified."
        )
    if not default:
        raise Inconclusive(
            f"build/FS.GG.Kit.props in the pinned {PACKAGE} package declares no FsggKitSkillRoots "
            f"default, so there is no pinned answer to where skills materialize. Nothing was verified."
        )
    return ([r for r in default.replace(";", " ").split() if r],
            "the pinned package's build/FS.GG.Kit.props default")


def _read(path, rel):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError) as e:
        raise Inconclusive(
            f"{rel} could not be read ({type(e).__name__}: {e}), so this tree's {PACKAGE} pin could "
            f"not be resolved and nothing was verified."
        )


def _parse(path, rel):
    try:
        return ET.fromstring(_read(path, rel))
    except ET.ParseError as e:
        raise Inconclusive(
            f"{rel} is not parsable XML ({e}), so this tree's {PACKAGE} pin could not be resolved. "
            f"Unparsable is not unpinned, and it is not coherent."
        )


def _imports(root, doc_dir, doc_rel, unresolved):
    """Every <Import Project=...> target of one MSBuild file, resolved to an absolute path.

    Only `$(MSBuildThisFileDirectory)` is expanded — it is the one property the canonical
    Directory.Packages.props uses, and the CPM pin shape reaches Directory.Packages.local.props through
    exactly this import. An import carrying any OTHER property is recorded in `unresolved` rather than
    guessed at, and it can only ever cost us a literal — which lands on "pin unresolvable" (exit 3), not
    on a pass. This resolver fails closed by construction.
    """
    for el in root.iter():
        if localname(el.tag) != "Import":
            continue
        proj = (el.get("Project") or "").strip()
        if not proj:
            continue
        expanded = proj.replace("$(MSBuildThisFileDirectory)", doc_dir + os.sep)
        if "$(" in expanded:
            unresolved.append(f"{doc_rel} imports '{proj}' (unexpanded MSBuild property)")
            continue
        yield os.path.normpath(os.path.join(doc_dir, expanded.replace("\\", os.sep)))


def _collect(target, path, literals, unresolved, seen):
    real = os.path.realpath(path)
    if real in seen:
        return                    # MSBuild tolerates a diamond import; a resolver must not loop on one.
    seen.add(real)
    rel = os.path.relpath(path, target)
    root = _parse(path, rel)
    for el in _kit_rows(root, ("PackageVersion", "PackageReference")):
        version, is_override = _version_of(el)
        if version:
            literals.append((rel, version, is_override))
    for imported in _imports(root, os.path.dirname(path), rel, unresolved):
        if os.path.isfile(imported):
            _collect(target, imported, literals, unresolved, seen)


def _walk_up_to_cpm(target, start_dir, literals, unresolved):
    """MSBuild's own Directory.Packages.props discovery: walk up, FIRST one found wins, then stop."""
    directory = os.path.realpath(start_dir)
    ceiling = os.path.realpath(target)
    while True:
        candidate = os.path.join(directory, "Directory.Packages.props")
        if os.path.isfile(candidate):
            _collect(target, candidate, literals, unresolved, set())
            return
        if directory == ceiling:
            return
        parent = os.path.dirname(directory)
        if parent == directory:
            return
        directory = parent


def resolve_pin(target, proj_rel):
    """This tree's effective FS.GG.Kit version, resolved the way MSBuild resolves it.

    DERIVED, NOT LISTED (#1584 criterion 2). The three pin shapes the org runs today are not enumerated
    anywhere in this function — they are what falls out of following the receiver project's own
    resolution:

      * an inline `Version=`/`VersionOverride=` on the PackageReference        -> read here, directly
      * CPM via Directory.Packages.props                                       -> the walk-up below
      * CPM via Directory.Packages.local.props                                 -> that file's own <Import>

    A hand-maintained table of which repo pins in which file is the defect class #1507/#1510/#1515/#1528
    closed, and it is precisely what rots when a fourth shape appears. This resolver learns a fourth
    shape for free if MSBuild does.
    """
    proj_path = os.path.join(target, proj_rel)
    if not os.path.isfile(proj_path):
        raise Inconclusive(
            f"the receiver project {proj_rel} does not exist in this tree, so there is no {PACKAGE} pin "
            f"to verify against and NOTHING was verified. A coordination-kit receiver on package "
            f"delivery carries one (kit-materialize.yml materializes FROM it); pass --receiver-project "
            f"if this repo keeps it elsewhere."
        )
    root = _parse(proj_path, proj_rel)
    refs = list(_kit_rows(root, ("PackageReference",)))
    if not refs:
        raise Inconclusive(
            f"{proj_rel} declares no {PACKAGE} PackageReference, so this tree does not reference the "
            f"kit package and its pin cannot be resolved."
        )

    unresolved = []
    literals = []
    for el in refs:
        version, is_override = _version_of(el)
        if version:
            literals.append((proj_rel, version, is_override))
    if not literals:
        _walk_up_to_cpm(target, os.path.dirname(proj_path), literals, unresolved)
    if not literals:
        hint = (" Imports left unexpanded: " + "; ".join(unresolved) + ".") if unresolved else ""
        raise Inconclusive(
            f"{proj_rel} references {PACKAGE} with no Version, which is the central-package-management "
            f"shape — but no Directory.Packages.props reachable from it (directly, or through its own "
            f"<Import>s, walking up to the repo root) declares a {PACKAGE} PackageVersion.{hint} The "
            f"pin is unresolvable; unresolvable is not unpinned, and it is not coherent."
        )

    overrides = [(p, v) for p, v, o in literals if o]
    if overrides:
        literals = [(p, v, True) for p, v in overrides]   # an override collapses the set, not contradicts it
    where = ", ".join(f"{p} -> {v}{' (VersionOverride)' if o else ''}" for p, v, o in literals)
    distinct = {v for _, v, _ in literals}
    if len(distinct) > 1:
        raise Inconclusive(
            f"{PACKAGE} is pinned to more than one version in this tree ({where}). The effective pin is "
            f"a restore-order accident, so no single version can be verified against."
        )
    return next(iter(distinct)), where


def restore(version):
    """The pinned .nupkg bytes, from the flat container. Retries only what a retry could fix."""
    ident = PACKAGE.lower()
    ver = version.lower()
    url = f"{fsgg_feed.NUGET_ORG}/{ident}/{ver}/{ident}.{ver}.nupkg"
    last = None
    for attempt in range(1, TRIES + 1):
        try:
            request = urllib.request.Request(
                url, headers={"User-Agent": "fsgg-coordination-sync", "Accept": "application/octet-stream"}
            )
            with urllib.request.urlopen(request, timeout=60) as resp:
                return resp.read(), url
        except urllib.error.HTTPError as e:
            if e.code == 404:
                # DETERMINISTIC, so it is not retried: a version the feed does not serve is a version
                # the receiver's own restore cannot resolve either. Retrying it would hold the runner
                # and still be wrong.
                raise Inconclusive(
                    f"{PACKAGE} {version} — the version THIS TREE pins — is not served at {url} "
                    f"(HTTP 404), so there was nothing to verify against. A pin the feed cannot serve "
                    f"is one this repo's own restore cannot resolve; fix the pin, or publish it."
                )
            last = f"HTTP {e.code} {e.reason}"
        except urllib.error.URLError as e:
            # file:// (the fixture's flat container) reports a missing package this way rather than as
            # an HTTP 404. Same determinism, same treatment — a resolver whose verdict depended on the
            # URL SCHEME would prove nothing about production.
            if isinstance(e.reason, FileNotFoundError):
                raise Inconclusive(
                    f"{PACKAGE} {version} — the version THIS TREE pins — is not present at {url}, so "
                    f"there was nothing to verify against."
                )
            last = f"unreachable: {e.reason}"
        except (TimeoutError, OSError, ValueError) as e:
            last = f"{type(e).__name__}: {e}"
        if attempt < TRIES:
            time.sleep(BACKOFF)
    raise Inconclusive(
        f"could not restore {PACKAGE} {version} from {url} after {TRIES} attempt(s) ({last}). NOTHING "
        f"was verified about this tree. This is a FEED failure — it is not drift, it is not a wiring "
        f"gap, and it is not this branch's doing.",
        retryable=True,
    )


def manifest_rows(blob, url):
    """(kind, package-relative path, receiver dest, sha256, executable) per kit-manifest.tsv row."""
    try:
        archive = zipfile.ZipFile(io.BytesIO(blob))
    except (zipfile.BadZipFile, OSError) as e:
        raise Inconclusive(f"the artifact served at {url} is not a readable .nupkg ({e}). Nothing was verified.")
    try:
        raw = archive.read("kit/kit-manifest.tsv").decode("utf-8")
    except (KeyError, UnicodeDecodeError) as e:
        raise Inconclusive(
            f"the {PACKAGE} package restored from {url} carries no readable kit/kit-manifest.tsv "
            f"({type(e).__name__}: {e}), so there is no comparand. The package is malformed."
        )
    rows = []
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        fields = line.split("\t")
        if len(fields) not in (4, 5):
            raise Inconclusive(
                f"kit/kit-manifest.tsv in {PACKAGE} carries a malformed row (want 4 legacy or 5 v2 "
                f"tab-separated fields): {line!r}. Nothing was verified."
            )
        kind, pkg_rel, dest, want = fields[0], fields[1], fields[2], fields[3].lower()
        if len(fields) == 4:
            executable = kind == "client"     # v1 compatibility, same rule build/FS.GG.Kit.targets uses.
        elif fields[4].strip().lower() in ("true", "false"):
            executable = fields[4].strip().lower() == "true"
        else:
            raise Inconclusive(
                f"kit/kit-manifest.tsv in {PACKAGE} carries a malformed executable field: {line!r}. "
                f"Nothing was verified."
            )
        rows.append((kind, pkg_rel, dest, want, executable))
    if not rows:
        # The floor build/FS.GG.Kit.targets holds on the materialize side, held again here: an empty
        # manifest would otherwise verify nothing and report a coherent kit — a silently missing kit,
        # the one failure mode ADR-0062 exists to rule out.
        raise Inconclusive(
            f"kit/kit-manifest.tsv in the {PACKAGE} package restored from {url} names no files, so a "
            f"tree could be verified against it vacuously. The package is malformed or truncated."
        )
    return rows, archive


def contained(target, path, what):
    """`path` resolved, asserted to sit inside the receiver root.

    Every destination this gate touches comes from the package's manifest, and the manifest is data —
    so a row naming `../../somewhere` would send the sha256 read, and the closed-set walk below, outside
    the tree under test. Nothing here writes, so the blast radius is a confusing verdict rather than a
    clobbered file; that is still a verdict about the wrong subject, which is the failure this fabric's
    comments keep coming back to. Assert containment instead of trusting the row.
    """
    resolved = os.path.realpath(path)
    root = os.path.realpath(target)
    if resolved != root and not resolved.startswith(root + os.sep):
        raise Inconclusive(
            f"the {PACKAGE} package's manifest names {what} {os.path.relpath(path, target)!r}, which "
            f"resolves outside the tree under test. Nothing was verified — a manifest that points out "
            f"of the receiver is a PRODUCER defect, not this tree's."
        )
    return resolved


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def verify(target, roots, rows, archive, include_build_config):
    managed_skill_dirs = {}
    for kind, pkg_rel, dest, want, executable in rows:
        if kind == "build-config" and not include_build_config:
            # OPT-IN on the materialize side (FsggKitMaterializeBuildConfig, default false), so it must
            # be opt-in here too. Verifying it unconditionally would red every receiver that correctly
            # does not carry it.
            continue

        # The package's INTERNAL coherence, checked before its payload is used as a comparand. This is
        # the only self-attestation this gate can break, and it is worth breaking: a package whose
        # payload disagrees with its own manifest is a producer defect, and grading a receiver against
        # it would blame the wrong tree. It is NOT proof the payload matches canonical — that is
        # check-kit-published-coherence.py's question, on the hub side (#1583).
        try:
            packed = archive.read("kit/" + pkg_rel)
        except KeyError:
            raise Inconclusive(
                f"the {PACKAGE} package's manifest names kit/{pkg_rel}, which the package does not "
                f"contain. The package is malformed; nothing was verified about this tree."
            )
        got = hashlib.sha256(packed).hexdigest()
        if got != want:
            raise Inconclusive(
                f"{PACKAGE} package integrity: kit/{pkg_rel} hashes {got} but its own manifest says "
                f"{want}. The package disagrees with itself, so it cannot be a comparand. This is a "
                f"PRODUCER defect, not this tree's."
            )

        # A skill row materializes into EVERY root; everything else has exactly one destination. The
        # skill DIRECTORY is carried alongside, because it is the closed-set unit swept below — and
        # deriving it from `dest`'s first component is what the materialize does, rather than
        # re-splitting the joined path afterwards.
        if kind == "skill":
            placements = [(os.path.join(root, dest), os.path.join(target, root, dest.split("/")[0]))
                          for root in roots]
        else:
            placements = [(dest, None)]

        for rel, skill_dir in placements:
            path = os.path.join(target, rel)
            resolved = contained(target, path, "a destination")
            if skill_dir is not None:
                # Registered whether or not the file is present: a MISSING file must not also silence
                # the closed-set sweep over the directory it belongs to.
                expected = managed_skill_dirs.setdefault(
                    contained(target, skill_dir, "a skill directory"), set())
                expected.add(resolved)
            if not os.path.isfile(path):
                emit("drift", "missing", rel)
                continue
            if sha256_file(path) != want:
                emit("drift", "differs", rel)
                continue
            # os.access(X_OK) answers True for everything when the process is root, which is how a mode
            # check quietly stops checking inside a container. Read the mode bits.
            is_exec = bool(stat.S_IMODE(os.stat(path).st_mode) & 0o111)
            if executable and not is_exec:
                emit("drift", "not executable", rel)
            elif not executable and is_exec:
                emit("drift", "unexpected executable", rel)
            else:
                emit("ok", rel)

    # A skill directory is a CLOSED transport unit — build/FS.GG.Kit.targets deletes undeclared files
    # inside one on every materialize, so a file the pinned package does not declare is a tree that does
    # not match its pin. Without this, a stale file left by an older kit survives every check.
    for skill_dir, expected in managed_skill_dirs.items():
        if not os.path.isdir(skill_dir):
            continue
        for dirpath, _dirnames, filenames in os.walk(skill_dir):
            for name in filenames:
                found = os.path.realpath(os.path.join(dirpath, name))
                if found not in expected:
                    emit("drift", "extra", os.path.relpath(found, target))


def main():
    target, proj_rel, roots_raw, include_bc = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
    try:
        version, where = resolve_pin(target, proj_rel)
        emit("pin", version, where)
        blob, url = restore(version)
        emit("source", url)
        rows, archive = manifest_rows(blob, url)
        roots, roots_src = skill_roots(target, proj_rel, archive, roots_raw)
        if not roots:
            raise Inconclusive(
                f"the skill roots resolved from {roots_src} are empty, so no skill file has a "
                f"destination to verify and a pass would be vacuous."
            )
        emit("roots", " ".join(roots), roots_src)
        verify(target, roots, rows, archive, include_bc == "yes")
    except Inconclusive as e:
        emit("inconclusive", "RETRYABLE" if e.retryable else "PERMANENT", str(e))
    print("\n".join(out))


main()
PY
)

# Roster gate: only repos that `receives: coordination-kit` hold the kit. If --repo is a non-receiver
# (e.g. the authority .github itself, or a repo removed from the kit list), there is nothing to do.
#
# Read the roster BEFORE classifying against it. "I could not ask the roster" and "the roster says no"
# are different answers, and only the second one may skip the drift check (.github#315): a failing
# repos.sh prints nothing, and matching $repo against nothing would report every receiver as a
# non-receiver and exit 0 green.
if [ -n "$repo" ]; then
  [ -f "$REG" ] || die "registry not found: $REG"
  roster_rc=0
  roster="$(bash "$SRC_ROOT/scripts/repos.sh" list --receives coordination-kit --registry "$REG")" \
    || roster_rc=$?
  [ "$roster_rc" -eq 0 ] \
    || die "could not read the coordination-kit roster from $REG (repos.sh exited $roster_rc)."
  [ -n "$roster" ] \
    || die "no repo declares 'receives: coordination-kit' in $REG — a capability the kit fabric requires."
  if ! printf '%s\n' "$roster" | grep -Fqx "$repo"; then
    echo "coordination-sync: $repo does not receive coordination-kit (per repos.yml) — nothing to do."
    exit 0
  fi
fi

# --- PIN-RELATIVE CHECK (--against-pin, #1584) ----------------------------------------------------
#
# Everything below this block reads THIS CHECKOUT as the comparand. The pin arm reads none of it, so it
# returns from here rather than falling through — the separation is the feature, and a later edit that
# lets the two share a comparand would silently reinstate the moving tip.
#
# The one thing above this line that IS a hub read is the roster gate, and it is worth being exact
# rather than reassuring about what it costs. It decides ONLY whether this repo is checked at all, so a
# hub commit can move a repo between "checked" and "skipped" — it can never turn a COHERENT tree into an
# INCOHERENT verdict, which is the retroactive red on byte-identical content that #1584 exists to close.
#
# Being exact: a hub commit that BREAKS the roster (an unparsable registry, a roster naming no receiver)
# still reds every receiver, because that read fails CLOSED by design (#315) and exits 2. That is a
# "could not check" red, not a "your tree is wrong" red, and this workflow reports it as one — but it is
# a hub-caused red and claiming otherwise here would be the kind of comfortable half-truth this file's
# own history warns about. What is gone is the channel that mattered: a hub commit changing the VERDICT
# on a tree it never touched. No byte of this checkout reaches the comparison below.
if [ -n "$against_pin" ]; then
  command -v python3 >/dev/null 2>&1 \
    || die "--against-pin needs python3 (it resolves the receiver's MSBuild pin, restores the pinned package, and verifies sha256s). Install python3 on this runner."
  [ -f "$HERE/fsgg_feed.py" ] \
    || die "the feed reader is not at $HERE/fsgg_feed.py. --against-pin IMPORTS its flat-container base from there rather than restating it, so that the version a receiver is graded against is resolved from the SAME registry the org preset routes FS.GG.* to (and therefore the same one Renovate bumps against). Without it no pin can be restored — and reporting that as a coherent kit is the fail-open this flag exists to remove."

  pin_project="${receiver_project:-$DEFAULT_RECEIVER_PROJECT}"
  pin_bc="no"; [ -z "$include_build_config" ] || pin_bc="yes"

  # The roots are handed over ONLY when a human named them in this run ($AGENT_SKILL_ROOTS). Otherwise
  # an EMPTY string goes across and the verifier derives them from the receiver project or from the
  # PINNED PACKAGE — never from this checkout's DEFAULT_ROOTS. That constant is hub state, and a pin
  # check that fell back to it would let a hub edit red every receiver over files "missing" from a root
  # they never adopted: #1584's own defect, arriving through the program instead of the data.
  # `$ROOTS_SRC` is resolve_roots' own report of which rule won, so this asks the resolver rather than
  # re-deriving the precedence and risking a second, disagreeing answer (#525).
  pin_roots=""
  [ "$ROOTS_SRC" != '$AGENT_SKILL_ROOTS' ] || pin_roots="$ROOTS"

  PIN_LEDGER="$(mktemp "${TMPDIR:-/tmp}/coordination-sync-pin.XXXXXX")"
  trap 'rm -f "$PIN_LEDGER"' EXIT
  # A crash of the verdict program is NOT a verdict. It reaches the caller as INCONCLUSIVE (3) and
  # never as green (#266) or as drift (#320) — the same discipline repos-audit.sh applies to its own
  # embedded program, for the same reason: an escaping traceback that fell through to exit 0 would be
  # the exact fail-open this flag was written to remove.
  pin_rc=0
  FSGG_SCRIPTS_DIR="$HERE" python3 -c "$PIN_VERIFY_PY" \
    "$target" "$pin_project" "$pin_roots" "$pin_bc" > "$PIN_LEDGER" || pin_rc=$?
  if [ "$pin_rc" -ne 0 ]; then
    echo "::error::coordination-sync: INCONCLUSIVE — the pin-relative verifier exited $pin_rc without reaching a verdict, so NOTHING was verified about this tree. This is not a coherent kit and it is not a drifted one." >&2
    exit 3
  fi

  pin_line="$(awk -F'\t' '$1 == "pin" { print; exit }' "$PIN_LEDGER")"
  [ -z "$pin_line" ] || echo "coordination-sync: pin = $(printf '%s' "$pin_line" | cut -f2) (from $(printf '%s' "$pin_line" | cut -f3))"
  src_line="$(awk -F'\t' '$1 == "source" { print $2; exit }' "$PIN_LEDGER")"
  [ -z "$src_line" ] || echo "coordination-sync: comparand = $src_line (the package's own kit-manifest.tsv; NOT this checkout)"
  roots_line="$(awk -F'\t' '$1 == "roots" { print; exit }' "$PIN_LEDGER")"
  [ -z "$roots_line" ] || echo "coordination-sync: skill roots = $(printf '%s' "$roots_line" | cut -f2) (from $(printf '%s' "$roots_line" | cut -f3))"

  # INCONCLUSIVE outranks everything. Some `ok` lines may already have been emitted before the read
  # failed, and a partial verification is not a verification.
  if grep -q '^inconclusive	' "$PIN_LEDGER"; then
    while IFS=$'\t' read -r _k class message; do
      echo "::error::coordination-sync: INCONCLUSIVE ($class) — $message" >&2
    done < <(grep '^inconclusive	' "$PIN_LEDGER")
    echo "::error::coordination-sync: NOTHING was verified about this tree. INCONCLUSIVE is neither 'the kit is coherent' nor 'the kit has drifted'; a RETRYABLE one is worth re-running, a PERMANENT one reproduces exactly and needs a commit." >&2
    exit 3
  fi

  awk -F'\t' '$1 == "ok" { print "ok: " $2 }' "$PIN_LEDGER"
  if grep -q '^drift	' "$PIN_LEDGER"; then
    while IFS=$'\t' read -r _k kind rel; do
      echo "::error::coordination-sync: DRIFT ($kind): $rel"
    done < <(grep '^drift	' "$PIN_LEDGER")
    if grep -q '^drift	not executable	' "$PIN_LEDGER"; then
      echo "::error::coordination-sync: a managed file matches its pinned package byte-for-byte but has LOST its executable bit — 'chmod +x' the file(s) above, or re-run the materialize, which restores the mode as well as the bytes." >&2
    fi
    pin_v="$(printf '%s' "$pin_line" | cut -f2)"
    echo "::error::coordination-sync: this tree does NOT match the FS.GG.Kit ${pin_v:-pin} it pins. This verdict is about THIS TREE ONLY — the hub was not consulted and cannot have caused it. Re-run the materialize to restore it: dotnet build $pin_project -t:FsggKitMaterialize" >&2
    exit 1
  fi
  ok_n="$(awk -F'\t' '$1 == "ok"' "$PIN_LEDGER" | wc -l | tr -d ' ')"
  echo "coordination-sync: OK — all $ok_n materialized file(s) match the FS.GG.Kit $(printf '%s' "$pin_line" | cut -f2) this tree pins."
  echo "coordination-sync: this says nothing about whether that pin is CURRENT — that is the #1540 kit-pin freshness sweep's question, and it is graded daily in FS-GG/.github regardless of whether this repo pushes."
  exit 0
fi

# The kit's skills: the `kind: skill` rows of registry/repos.yml, READ from the registry rather than
# copied into a literal here. A copy is a second source of truth that nothing compares against the
# first, so a skill could be registered — and digest-checked on every edit — yet never distributed,
# while `--check` passed on a receiver that lacked it (.github#338).
#
# Same fail-closed discipline as the roster gate above, and for the same reason: a repos.sh that dies
# prints nothing, and an empty skill list would distribute the client alone and then report every
# receiver coherent. "I could not ask the registry" is not "the kit has no skills".
#
# Read each row's `source` PATH, not its id. `source` is what the registry declares (and what its
# digest is taken over); `.claude/skills/<id>` is a convention nothing enforces — `validate` accepts a
# row whose id and source directory differ. Rebuilding the path from the id would be this very bug one
# field over: a location invented here instead of read from the registry that owns it.
[ -f "$REG" ] || die "registry not found: $REG"
skills_rc=0
KIT_SKILL_SRCS="$(bash "$SRC_ROOT/scripts/repos.sh" kit --field source --kind skill --registry "$REG")" \
  || skills_rc=$?
[ "$skills_rc" -eq 0 ] \
  || die "could not read the kit skill list from $REG (repos.sh exited $skills_rc)."
[ -n "$KIT_SKILL_SRCS" ] \
  || die "no 'kind: skill' kit item declared in $REG — the coordination kit requires at least one."

# The kit's `kind: client` executables: READ from the registry, not named here (.github#1696).
#
# This block used to be a literal `scripts/fsgg-coord` inside `managed()` — the invented-location bug
# the skills block above warns about in as many words, three rows over, and latent only because the
# kit had exactly one client row for its whole existence. Adding a second (`scripts/skill-view`, the
# ADR-0067 §9 replacement) made it observable immediately: `stage-kit.sh` DERIVES the package's
# manifest from this same registry, so the package carried the new client while this byte-copy writer
# did not — and `--check --against-pin`, which reads the package's manifest, reported the receiver
# this very script had just written as DRIFT (missing). Two distribution paths for one kit, disagreeing
# about what the kit IS, is exactly what ADR-0058 and #338 exist to prevent.
#
# A client's dest IS its source path (`repos.sh validate` enforces that), so unlike a config there is
# nothing to zip — but the SOURCE still comes from the registry rather than from a convention.
# Fail-closed like the skills read, and for the same reason: ADR-0062 defines the kit to carry a
# client, so "the registry declares none" is a broken registry, not a smaller kit.
client_rc=0
KIT_CLIENT_SRCS="$(bash "$SRC_ROOT/scripts/repos.sh" kit --field source --kind client --registry "$REG")" \
  || client_rc=$?
[ "$client_rc" -eq 0 ] \
  || die "could not read the kit client list from $REG (repos.sh exited $client_rc)."
[ -n "$KIT_CLIENT_SRCS" ] \
  || die "no 'kind: client' kit item declared in $REG — the coordination kit requires at least one."

# The kit's `kind: config` files: plain files delivered to a receiver path that is NOT their source —
# .config/dotnet-tools.json, the manifest that lets a receiver `dotnet tool restore` the engine the
# fsgg-coord client execs (#1077). Read source AND dest from the registry (a config NAMES its dest, so
# rebuilding it here would be the invented-location bug the skills block warns about, one row over).
# Capture each into a variable so a repos.sh that DIES propagates its exit code — a `paste <(...)` would
# swallow it — same fail-closed discipline as the skills read: "I could not ask the registry" is not
# "the kit has no config files". Config is OPTIONAL (a kit may declare none), unlike skills.
cfg_src_rc=0
KIT_CONFIG_SRCS="$(bash "$SRC_ROOT/scripts/repos.sh" kit --field source --kind config --registry "$REG")" \
  || cfg_src_rc=$?
[ "$cfg_src_rc" -eq 0 ] || die "could not read the kit config sources from $REG (repos.sh exited $cfg_src_rc)."
cfg_dst_rc=0
KIT_CONFIG_DSTS="$(bash "$SRC_ROOT/scripts/repos.sh" kit --field dest --kind config --registry "$REG")" \
  || cfg_dst_rc=$?
[ "$cfg_dst_rc" -eq 0 ] || die "could not read the kit config dests from $REG (repos.sh exited $cfg_dst_rc)."
# Zip into source<TAB>dest lines; jq emits both fields in .kit order, so paste aligns them row-for-row.
# The printf process substitutions cannot fail, so the fail-closed check above stands.
KIT_CONFIG_PAIRS=""
[ -z "$KIT_CONFIG_SRCS" ] \
  || KIT_CONFIG_PAIRS="$(paste <(printf '%s\n' "$KIT_CONFIG_SRCS") <(printf '%s\n' "$KIT_CONFIG_DSTS"))"
# Fail CLOSED on a config row with no usable dest. `repos.sh validate` enforces the dest, but this
# script does not run it, and `repos.sh kit --field dest` renders a MISSING dest as the literal "null"
# (jq -r) — so on an unvalidated registry a dest-less row would otherwise be distributed to `$target/null`
# (or, if empty, the target root). "I read a malformed row" must not become a silent mis-write.
[ -z "$KIT_CONFIG_PAIRS" ] || while IFS=$'\t' read -r _s _d; do
  [ -n "$_s" ] || continue
  case "$_d" in ""|null) die "kit config source '$_s' has no usable dest (got '$_d') — a 'kind: config' row must declare a receiver-relative 'dest' (run: scripts/repos.sh validate)." ;; esac
done <<< "$KIT_CONFIG_PAIRS"

# Build the managed source::dest list (dest is relative to the receiver root).
managed() {
  local r src name s d full rel
  while IFS= read -r src; do
    [ -n "$src" ] || continue
    printf '%s::%s\n' "$src" "$src"    # client: its dest IS its source path (repos.sh validate)
  done <<< "$KIT_CLIENT_SRCS"
  for src in $KIT_SKILL_SRCS; do
    name="${src##*/}"
    [ -d "$SRC_ROOT/$src" ] || die "canonical kit skill source missing: $src"
    if find "$SRC_ROOT/$src" -mindepth 1 ! -type d ! -type f -print -quit | grep -q .; then
      die "canonical kit skill source contains a non-regular file: $src"
    fi
    for r in $ROOTS; do
      while IFS= read -r -d '' full; do
        rel="${full#"$SRC_ROOT/$src/"}"
        printf '%s::%s\n' "$src/$rel" "$r/$name/$rel"
      done < <(find "$SRC_ROOT/$src" -type f -print0 | LC_ALL=C sort -z)
    done
  done
  [ -z "$KIT_CONFIG_PAIRS" ] || while IFS=$'\t' read -r s d; do
    [ -n "$s" ] || continue
    printf '%s::%s\n' "$s" "$d"          # config: canonical source -> its own receiver dest
  done <<< "$KIT_CONFIG_PAIRS"
}

# Every canonical source must exist before we compare or copy ANYTHING. Hoisted out of the loops below
# so it dies in the main shell: the drift readers run in `$(...)`, where a `die` would only kill the
# subshell, and "I could not find the kit to compare against" must never reach a caller as a verdict.
while IFS= read -r entry; do
  [ -n "$entry" ] || continue
  rel_src="${entry%%::*}"
  [ -f "$SRC_ROOT/$rel_src" ] || die "canonical kit source missing: $rel_src (is this a .github checkout?)"
  # A byte-copied `.json` source that is MALFORMED passes --check (the receiver's bytes match canonical)
  # yet breaks `dotnet tool restore` in every receiver — the manifest's #29 hazard, which sync-build-config
  # guarded until #1077 moved the manifest here. Assert JSON well-formedness at the SOURCE before we
  # distribute or certify it: jq, else python3, else warn (don't block) if neither is present.
  case "$rel_src" in
    *.json)
      if command -v jq >/dev/null 2>&1; then
        jq -e . "$SRC_ROOT/$rel_src" >/dev/null 2>&1 \
          || die "canonical kit source is not valid JSON: $rel_src — fix the source of truth before distributing."
      elif command -v python3 >/dev/null 2>&1; then
        python3 -c 'import sys,json; json.load(open(sys.argv[1]))' "$SRC_ROOT/$rel_src" 2>/dev/null \
          || die "canonical kit source is not valid JSON: $rel_src — fix the source of truth before distributing."
      else
        echo "WARN: no jq or python3 found; skipping JSON well-formedness check of $rel_src" >&2
      fi
      ;;
  esac
done < <(managed)

# Which managed files must be EXECUTABLE in the receiver — keyed on the canonical source's OWN mode, and
# read by BOTH arms below, so `apply` chmods exactly what `check` asserts. The two arms used to carry
# separate rules: apply chmodded the client, check compared bytes with `diff -q` and never looked at a
# mode. A receiver whose client had lost its +x bit was therefore byte-identical to canonical, so the gate
# pronounced the kit coherent while every worker in that repo got `permission denied` running the very
# client it had just certified (.github#506). The check's subject is "the kit is USABLE here"; bytes alone
# are not evidence of that, and a mode sits inside the subject and outside the evidence.
wants_exec() { [ -x "$SRC_ROOT/$1" ]; }        # $1 = rel_src
# ...and that rule is only as good as the mode it reads. If THIS checkout has lost the client's +x bit,
# `wants_exec` answers "no" everywhere and BOTH arms quietly stop caring — the same fail-open, one level
# up, that #315 already cost this script. A source we cannot trust is not a verdict: fail closed.
# Asserted over EVERY declared client, not just the first one to have existed (.github#1696). The
# guard's subject is "a kit whose client cannot run", and a kit with two clients has two ways to be
# that kit — `scripts/skill-view` losing its +x bit fails open in precisely the way this line was
# written to close.
while IFS= read -r _client; do
  [ -n "$_client" ] || continue
  [ -x "$SRC_ROOT/$_client" ] \
    || die "canonical $_client is not executable in $SRC_ROOT — refusing to distribute or certify a kit whose client cannot run ('chmod +x $_client')."
done <<< "$KIT_CLIENT_SRCS"

if [ "$mode" = "apply" ]; then
  # Managed skill directories are closed sets. Remove files a prior kit version declared but the
  # current source no longer does, then copy the current deterministic set.
  for src in $KIT_SKILL_SRCS; do
    name="${src##*/}"
    for r in $ROOTS; do
      dst_dir="$target/$r/$name"
      [ ! -d "$dst_dir" ] || while IFS= read -r -d '' old; do
        rel="${old#"$dst_dir/"}"
        [ -f "$SRC_ROOT/$src/$rel" ] || { rm -f "$old"; echo "removed: $r/$name/$rel"; }
      done < <(find "$dst_dir" -mindepth 1 ! -type d -print0)
    done
  done
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    rel_src="${entry%%::*}"; rel_dst="${entry##*::}"
    dst="$target/$rel_dst"
    mkdir -p "$(dirname "$dst")"
    cp "$SRC_ROOT/$rel_src" "$dst"
    if wants_exec "$rel_src"; then chmod a+x "$dst"; else chmod a-x "$dst"; fi
    echo "wrote: $rel_dst"
  done < <(managed)
  echo "coordination-sync: kit written into $target"
  exit 0
fi

# --- check ---------------------------------------------------------------------------------------
# Compare one tree against canonical. With no <ref> that tree is the working checkout; with a <ref> it
# is that commit's tree, read out of git. Prints one "<ok|missing|differs>\t<rel_dst>" line per file.
tree_status() {   # tree_status [<ref>]
  local ref="${1:-}" entry rel_src rel_dst src
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    rel_src="${entry%%::*}"; rel_dst="${entry##*::}"
    src="$SRC_ROOT/$rel_src"
    if [ -z "$ref" ]; then
      if   [ ! -f "$target/$rel_dst" ];                                   then printf 'missing\t%s\n' "$rel_dst"
      elif ! diff -q "$src" "$target/$rel_dst" >/dev/null 2>&1;           then printf 'differs\t%s\n' "$rel_dst"
      elif wants_exec "$rel_src" && [ ! -x "$target/$rel_dst" ];          then printf 'not executable\t%s\n' "$rel_dst"
      elif ! wants_exec "$rel_src" && [ -x "$target/$rel_dst" ];          then printf 'unexpected executable\t%s\n' "$rel_dst"
      else                                                                     printf 'ok\t%s\n'      "$rel_dst"; fi
    else
      # `<rev>:./<path>` resolves the path relative to the CWD (here: $target). Plain `<rev>:<path>` is
      # relative to the REPO ROOT, which is a different file whenever <target> is a subdirectory of the
      # checkout — precisely what the gate's `target-path` input lets a caller ask for.
      #
      # The mode comes from the TREE, not the worktree: `ls-tree` reports what the commit actually records
      # (100755 vs 100644), which is the only place a <ref> read can learn it. Its pathspec is CWD-relative
      # like the `:./` above, so it asks about the same file. A blob mode git does not report as 100755 is
      # not executable, whatever the checkout on disk happens to say.
      if   ! git -C "$target" cat-file -e "$ref:./$rel_dst" 2>/dev/null;  then printf 'missing\t%s\n' "$rel_dst"
      elif ! git -C "$target" show "$ref:./$rel_dst" 2>/dev/null \
             | diff -q "$src" - >/dev/null 2>&1;                          then printf 'differs\t%s\n' "$rel_dst"
      elif wants_exec "$rel_src" \
           && [ "$(git -C "$target" ls-tree "$ref" -- "$rel_dst" | cut -d' ' -f1)" != "100755" ]; then
                                                                               printf 'not executable\t%s\n' "$rel_dst"
      else                                                                     printf 'ok\t%s\n'      "$rel_dst"; fi
    fi
  done < <(managed)
  if [ -z "$ref" ]; then
    local_src=""
    for local_src in $KIT_SKILL_SRCS; do
      local_name="${local_src##*/}"
      for local_root in $ROOTS; do
        local_dir="$target/$local_root/$local_name"
        [ ! -d "$local_dir" ] || while IFS= read -r -d '' local_file; do
          local_rel="${local_file#"$local_dir/"}"
          [ -f "$SRC_ROOT/$local_src/$local_rel" ] \
            || printf 'extra\t%s\n' "$local_root/$local_name/$local_rel"
        done < <(find "$local_dir" -mindepth 1 ! -type d -print0 | LC_ALL=C sort -z)
      done
    done
  fi
}
drifted() { printf '%s\n' "$1" | grep -v '^ok	' || true; }   # the non-ok lines of a tree_status block
# `if`, not `[ x ] && echo` — under `set -e` a trailing `&&` list that goes false makes the while body,
# and so the whole pipeline, exit 1, killing the script BEFORE it prints its annotations. That failure is
# invisible to an exit-code assertion (1 is also the drift code), and it goes red saying nothing at all.
announce() { printf '%s\n' "$2" | while IFS=$'\t' read -r kind rel; do
               if [ -n "$kind" ]; then echo "::$1::coordination-sync: DRIFT ($kind): $rel"; fi; done; }

head_status="$(tree_status)"
head_drift="$(drifted "$head_status")"

# STRICT (no --base-ref): the tree either equals canonical or it does not. This is what a push to the
# receiver's main runs, and what the fixture drives — it is the verdict of record on a repo's kit, and
# it is unchanged. The attribution below only ever RELAXES a red on a branch that did not cause it, so
# main keeps a true red to relax against.
if [ -z "$base_ref" ]; then
  printf '%s\n' "$head_status" | while IFS=$'\t' read -r kind rel; do
    if [ "$kind" = "ok" ]; then echo "ok: $rel"; fi; done
  if [ -n "$head_drift" ]; then
    announce error "$head_drift"
    # A mode drift's fix is not the one a byte drift's reader reaches for: the file is already correct, so
    # "re-sync it" reads as a no-op and the reader disbelieves the gate. Name the bit.
    if printf '%s\n' "$head_drift" | grep -q '^not executable	'; then
      echo "::error::coordination-sync: a managed file is byte-identical to canonical but has LOST its executable bit — run 'chmod +x' on the file(s) above (or re-run 'coordination-sync $target', which restores the mode as well as the bytes)." >&2
    fi
    echo "::error::coordination-sync: kit is INCOHERENT — run 'coordination-sync $target' from a .github checkout to fix." >&2
    exit 1
  fi
  echo "coordination-sync: OK — kit coherent in $target"
  exit 0
fi

# ATTRIBUTED (--base-ref <ref>): ask WHO AUTHORED the difference before calling it the PR's drift.
#
# The old check answered one question — "does <target> equal canonical?" — and printed the same red for
# every way the answer could be no. Three unrelated situations produce that red, and only ONE of them is
# the author's to fix:
#
#   1. the branch itself edits a vendored kit file       -> REAL drift. The kit is owned by .github.
#   2. the base branch is BEHIND canonical               -> the REPO's drift. A Renovate FS.GG.Kit bump
#                                                           (re-materialized by kit-materialize) brings it
#                                                           current; a PR author cannot fix it.
#   3. the branch predates a kit sync already on base    -> nothing is wrong AT ALL.
#
# Canonical is `.github@main`, which moves constantly, so (2) and (3) fire on PRs that never went near
# the kit. A worker read that red as a repo defect and filed a long, well-evidenced issue about a kit
# resync that had merged 110 SECONDS EARLIER (FS.GG.Rendering#473, the phantom). A second worker lost an
# hour to the same signal 20 minutes later. A check that is red for a reason its reader cannot fix is one
# they learn to ignore — and a gate nobody reads cannot catch the real drift when it comes.
#
# `<ref>...HEAD` is merge-base-relative, which is exactly the "what did this BRANCH author" question —
# and it is right whether the caller checked out the PR's head or its merge commit, since the base is an
# ancestor of both. Anything else the branch differs by, it inherited.
git -C "$target" rev-parse --git-dir >/dev/null 2>&1 \
  || die "--base-ref needs <target> to be a git checkout: $target"
git -C "$target" rev-parse --verify --quiet "$base_ref^{commit}" >/dev/null \
  || die "--base-ref '$base_ref' is not resolvable in $target — fetch the base branch first."

mapfile -t DSTS < <(managed | sed 's/.*:://')
authored="$(git -C "$target" diff --name-only "$base_ref...HEAD" -- "${DSTS[@]}")"
base_drift="$(drifted "$(tree_status "$base_ref")")"

# Split the drift by WHO AUTHORED IT, FILE BY FILE. Asking the coarser question — "did this branch touch
# ANY kit file?" — and then blaming it for the whole drift set would re-commit this very misattribution
# one level in: a branch that hand-restores one kit file while INHERITING another's staleness would be
# red for the file it never touched.
authored_drift=""; inherited_drift=""
while IFS=$'\t' read -r kind rel; do
  [ -n "$kind" ] || continue
  if printf '%s\n' "$authored" | grep -Fqx "$rel"; then
    authored_drift+="$kind	$rel"$'\n'
  else
    inherited_drift+="$kind	$rel"$'\n'
  fi
done <<< "$head_drift"

# (1) Drift this branch AUTHORED is the branch's, always. The kit is owned by .github.
if [ -n "$authored_drift" ]; then
  announce error "$authored_drift"
  echo "::error::coordination-sync: this branch changes a vendored kit file and the result does NOT match canonical." >&2
  echo "::error::coordination-sync: the kit is owned by FS-GG/.github — land the change THERE (it reaches this repo as an FS.GG.Kit package bump via kit-materialize), or run 'coordination-sync $target' from a .github checkout to restore it." >&2
  exit 1
fi

# A branch MAY touch the kit correctly — the coordination-kit/sync PR does exactly that, and a gate that
# red the one PR which fixes the drift would deadlock the fabric.
if [ -n "$authored" ]; then
  echo "coordination-sync: this branch updates the kit, and the result matches canonical:"
  printf '%s\n' "$authored" | while IFS= read -r f; do if [ -n "$f" ]; then echo "  $f"; fi; done
fi

# Whatever drift is left, the branch INHERITED. That is never its fault, and the base decides whose it is.
if [ -z "$inherited_drift" ]; then
  echo "coordination-sync: OK — no kit drift this branch is responsible for."
  exit 0
fi

if [ -z "$base_drift" ]; then
  # (3) Base is coherent, so the branch is simply older than a sync that already landed. Nothing is wrong.
  announce notice "$inherited_drift"
  echo "::notice::coordination-sync: your branch predates a kit sync that is ALREADY on '$base_ref' — '$base_ref' is in sync with canonical and this branch does not change the kit. Nothing to do (rebase to clear the diff)." >&2
  echo "coordination-sync: OK — '$base_ref' is coherent; this branch merely predates its kit sync."
  exit 0
fi

# (2) Base is genuinely behind canonical. Real drift — but the REPO's, not this branch's. Report it where
# the author will see it, name the arm that owes the fix, and DO NOT red their PR: the receiver's own
# push-to-main run is the verdict of record here, and that one is still strict (above). Every receiver
# wires `push: branches: [main]` alongside `pull_request`, so that run exists — this advisory relaxes a
# red on the branch, it does not retire the red on the repo.
announce warning "$inherited_drift"
echo "::warning::coordination-sync: '$base_ref' is BEHIND the canonical kit ($(printf '%s' "$inherited_drift" | grep -c .) file(s) above). This is NOT caused by your branch and CANNOT be fixed in it." >&2
echo "::warning::coordination-sync: a Renovate FS.GG.Kit bump (re-materialized by kit-materialize) brings ${repo:-this repo} current; landing that is what clears this. Your PR is unaffected — merging it neither causes nor worsens the drift." >&2
echo "coordination-sync: OK — kit drift on '$base_ref' is not this branch's (advisory above)."
exit 0
