#!/usr/bin/env bash
# The GENERATED, CI-GATED artifacts of this repo — derived by asking each generator, never declared
# (ADR-0044, .github#498).
#
#   scripts/generated-paths           # the SUBTRACTABLE set: one repo-relative path per line
#   scripts/generated-paths --all     # every row every generator emits: kind<TAB>path<TAB>marker
#   scripts/generated-paths --roster  # the generators themselves, one `--list` invocation per line
#
# WHAT THIS IS FOR. `intra-repo-parallel-work` §1 tells a worker NOT to reserve a generated, CI-gated
# artifact in their `Paths:` touch-set: nobody authors it, so a collision there is a rebase, not a
# decision (#309). Having told them that, `verify-paths` then reported the regenerated file as DRIFT —
# correctly, and forever. A signal that fires on the behaviour the protocol MANDATES is one workers
# learn to skip past, and the one time it means a real overrun, nobody reads it (#498). This command is
# the list `verify-paths` subtracts so that stops happening.
#
# WHY DERIVED, AND NOT A LIST SOMEBODY KEEPS. #498 filed two options and the org declined BOTH: a
# `Generated:` line in each issue body (a hand-copied list, per item, forever) and a repo-level ignore
# file (`.fsgg/generated-paths`). The ignore file is the instructive one. It fails OPEN: a stale entry
# silently suppresses a REAL drift finding, which is the #266 family exactly — a gate reporting green
# over a subject it can no longer see — and it would have been introduced by the change meant to make
# drift reporting trustworthy.
#
# Both options are a second copy of a fact the generator already holds. That is the actual defect, and
# this repo has already paid for it once: `generate-projections`' own comment records that the first
# copy of its target list "drifted into `projections.yml` and had to be edited in step, by hand". The
# fix then was to read the generator's own list. Re-introducing that copy to solve a problem CAUSED by
# generated artifacts would be a poor joke. So: the generator cannot forget what it emits, because
# emitting it is what it does (#609 — an import cannot drift by construction).
#
# THE ONE THING STILL WRITTEN BY HAND IS THE ROSTER BELOW — AND ITS FAILURE DIRECTION IS THE WHOLE
# ARGUMENT. A roster of GENERATORS is not a roster of ARTIFACTS:
#
#   * Forget an ARTIFACT (the declined ignore-file) and drift on it is silently suppressed. Fail-open,
#     and invisible.
#   * Forget a GENERATOR here and its artifacts are simply not subtracted — a worker sees the expected
#     drift line they see today. Fail-closed, and the failure is NOISE, which someone eventually
#     complains about. #498 is that complaint.
#
# So the copy that remains is the one whose staleness cannot hide. It is still gated
# (`scripts/check-generator-list.py`), because "fails safe" is a reason to allow a copy, not a reason
# to stop watching it.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"

ALL=""
ROSTER=""
case "${1:-}" in
  --all)    ALL=1 ;;
  --roster) ROSTER=1 ;;
  "") ;;
  *) echo "::error::unknown argument: $1 (expected --all, --roster, or nothing)" >&2; exit 2 ;;
esac

# THE ROSTER — every generator, as the exact argv that asks it what it emits. An invocation, not a
# script name, because a generator is not always a whole file: `repos.sh` is a multi-command tool whose
# GENERATOR is the `relock` subcommand, and it already has an unrelated `list` subcommand of its own.
# Asking `repos.sh --list` would be asking the wrong thing of the wrong subject.
#
# TO ADD A GENERATOR: add its `--list` invocation here. The gate will then hold you to the contract —
# it must answer in format, exit 0, touch nothing, and be run with `--check` by a workflow.
GENERATORS=(
  "scripts/generate-projections --list"
  "scripts/generate-skill-union-bundle --list"
  "scripts/repos.sh relock --list"
)

# `--roster` exists so the GATE reads this array by ASKING for it, rather than parsing bash from
# Python. A gate that re-derives its own subject list is the second copy again, one level up — and it
# would be the copy that decides whether the first one is honest.
if [ -n "$ROSTER" ]; then
  printf '%s\n' "${GENERATORS[@]}"
  exit 0
fi

[ "${#GENERATORS[@]}" -gt 0 ] || {
  echo "::error::generated-paths: the roster is EMPTY — refusing to answer 'nothing is generated', which is not the same fact." >&2
  exit 2
}

# Ask one generator. FAILS CLOSED, LOUDLY: a generator that errors, or that answers nothing,
# contributes NOTHING to the subtraction and says so on stderr — it must never be read as "this
# generator emits no artifacts", because the two are opposite facts and only one of them is safe.
# #498's own acceptance turns on this: an empty or absent `--list` must leave drift reported exactly as
# it is today, never subtract everything. That is the #266 shape aimed at this very command, so it is
# the one condition this script refuses to get wrong.
ask() {
  local inv="$1" out err rc=0
  err="$(mktemp "${TMPDIR:-/tmp}/generated-paths.err.XXXXXX")"
  # Word-split deliberately: the roster holds argv, not a path.
  # shellcheck disable=SC2086
  out="$(cd "$HERE" && $inv 2>"$err")" || rc=$?

  if [ "$rc" -ne 0 ]; then
    # The generator's OWN reason, not just its exit code. This used to be `2>/dev/null`, which threw
    # away the one sentence that says why — leaving "exited 2" to stand in for "jq not found",
    # "registry not found", and a typo in the roster alike. A warning nobody can act on is a warning
    # nobody reads.
    echo "::warning::generated-paths: '$inv' exited $rc — its artifacts are NOT subtracted (drift on them stays reported)." >&2
    sed 's/^/  | /' "$err" >&2
    rm -f "$err"
    return 0
  fi
  rm -f "$err"
  if [ -z "$out" ]; then
    echo "::warning::generated-paths: '$inv' listed nothing — its artifacts are NOT subtracted." >&2
    return 0
  fi
  printf '%s\n' "$out"
}

rows() { local g; for g in "${GENERATORS[@]}"; do ask "$g"; done; }

if [ -n "$ALL" ]; then
  rows
  exit 0
fi

# THE SUBTRACTABLE SET IS THE EMPTY-MARKER ROWS, AND THAT DISTINCTION IS LOAD-BEARING — dropping it
# would build the fail-open this whole design refuses.
#
# A row with a MARKER names a generated REGION inside a file somebody else authored:
# `docs/coordination/parallel-work.md` is prose with one generated block in it, and every
# `SKILL.md` `generate-projections` touches is the same shape. Those files ARE authored, so #309's rule
# never applied to them — a worker who edits one must declare it, and drift on it is a true finding.
# Subtracting them because they happen to contain a generated region would suppress drift across the
# authored 90% of the org's protocol documents, which is a far bigger hole than the noise #498 is about.
#
# An EMPTY marker names a whole file that nobody authors — `registry/repos.lock`,
# `dist/skill-union-assert.sh`. That is #309's authorship test, and it is exactly the set that may be
# subtracted. Both of #498's own motivating examples are this shape.
#
# A row must have EXACTLY three fields to be read at all, and that strictness is the point rather
# than tidiness. `NF >= 2` was the first spelling and it is a fail-open: a two-field row has no
# third field, so `$3 == ""` is vacuously true and the path is subtracted — which is precisely what
# a REGION generator that dropped its marker column would emit. The permissive read turns "this
# generator's output is malformed" into "this authored file may be silently un-reported", and it
# does it in the runtime path, where `check-generator-list.py` is not there to object: the gate runs
# in CI on changed paths, this command runs whenever `verify-paths` asks. The stricter reader is the
# one that has to hold, because it is the one nothing is watching.
#
# So: three fields, or the row is not believed — warned about, and NOT subtracted.
rows | awk -F'\t' '
  NF != 3 {
    printf "::warning::generated-paths: malformed row (%d field(s), want 3) — NOT subtracted: %s\n", NF, $0 > "/dev/stderr"
    next
  }
  $2 == "" { next }
  $3 == "" { print $2 }
' | LC_ALL=C sort -u
