<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Roll forward if the exact net10.0 runtime is absent on the host, matching the org's
         CLI convention (FS.GG.SDD.Cli). -->
    <RollForward>Major</RollForward>

    <!-- Distribute as a .NET global tool so the clone-free install the tutorial documents
         keeps working: `dotnet tool install -g FS.GG.NewSddFullstack` exposes the
         `new-sdd-fullstack` command (the F# successor to the retired shell script; ADR-0016).
         Package identity = product identity — do not rename in place. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>new-sdd-fullstack</ToolCommandName>
    <PackageId>FS.GG.NewSddFullstack</PackageId>
    <Version>0.1.1-preview.1</Version>
    <AssemblyName>new-sdd-fullstack</AssemblyName>

    <Description>Full-stack FS.GG product scaffolder (SDD lifecycle + runnable Rendering app + Governance overlay) with a rich Spectre.Console progress UI. Orchestrates existing published machinery; no FS.GG.Templates checkout required.</Description>
    <Authors>FS-GG</Authors>
    <Company>FS-GG</Company>
    <PackageTags>fsgg;scaffold;dotnet-tool;sdd;spectre</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/FS-GG/.github</RepositoryUrl>
    <PackageProjectUrl>https://github.com/FS-GG/.github/tree/main/scripts/NewSddFullstack</PackageProjectUrl>

    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
</Project>
