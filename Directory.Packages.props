<Project>
  <!-- Central Package Management for the .github repo. The repo is mostly docs/registry/scripts, but
       it is also a PRODUCER: scripts/NewSddWorkspace (the workspace scaffolder, a dotnet tool since
       ADR-0016) and, since ADR-0034, the typed coordination engine — FS.GG.Coord.Core (the domain),
       FS.GG.Coord.Cli (its executable edge), and their test projects. Pins track the org-common set:
       FSharp.Core 10.1.301 and Spectre.Console 0.57.2 (the version verified in FS.GG.SDD /
       FS.GG.Governance — see the spectre-console skill, "Version scope").

       Note the engine takes NO Spectre dependency: it is invoked once per scheduling call on every
       worker in a fan-out, so its startup cost IS its runtime cost. JSON is its contract. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="10.1.301" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <!-- FS.GG.Coord.Core tests (ADR-0034 Phase 1). xUnit is the org standard (FS.GG.SDD has 138
         files opening Xunit; Expecto is unused). FsCheck is scoped to round-trip properties, exactly
         as SDD scopes it. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.3" />
  </ItemGroup>
</Project>
