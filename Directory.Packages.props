<Project>
  <!-- Central Package Management for the .github repo. The repo is mostly docs/registry/scripts, but
       it is also a PRODUCER: scripts/NewSddWorkspace (the workspace scaffolder, a dotnet tool since
       ADR-0016) and, since ADR-0034, the typed coordination engine — FS.GG.Coord.Core (the domain),
       FS.GG.Coord.Cli (its executable edge), and their test projects. Pins track the org-common set:
       FSharp.Core 10.1.301 and Spectre.Console 0.57.2 (the version verified in FS.GG.SDD /
       FS.GG.Governance — see the spectre-console skill, "Version scope").

       Note the engine takes NO Spectre dependency: it is invoked once per scheduling call on every
       worker in a fan-out, so its startup cost IS its runtime cost. JSON is its contract. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="10.1.302" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <!-- FS.GG.Coord.Core tests (ADR-0034 Phase 1). xUnit is the org standard (FS.GG.SDD has 138
         files opening Xunit; Expecto is unused). FsCheck is scoped to round-trip properties, exactly
         as SDD scopes it. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.3" />
  </ItemGroup>

  <!-- api-breaking-change-gate (.github#20, #609). The root Directory.Build.props imports the org-shared
       config, which carries the OPT-IN gate: setting FsggApiGate adds a PackageReference to
       Microsoft.CodeAnalysis.PublicApiAnalyzers with no inline version, because under CPM the version is
       expected to come from the org's Directory.Packages.props. .github does NOT adopt that file — it
       keeps this hand-rolled one (the org baseline's FSharp.Core pin would collide, NU1506) — so without
       this row the gate is REACHABLE here and BROKEN here: opting in fails restore with NU1010, in the
       one repo that authored the gate. Pinned to the same 5.6.0 the org file pins.

       This row is lock-neutral by construction, which is why it can sit here unused: a PackageVersion
       with no matching PackageReference never enters the restore graph or packages.lock.json. It arms
       nothing on its own; it only makes the documented opt-in work. -->
  <ItemGroup Label="api-breaking-change-gate">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
